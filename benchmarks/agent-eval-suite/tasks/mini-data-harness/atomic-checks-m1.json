{
  "task": "mini-data-harness",
  "milestone": "M1_bootstrap",
  "checks": [
    {
      "id": "prompt_read_spec",
      "group": "prompt",
      "description": "读取 docs/data-harness-spec.md",
      "method": "evidence_path_contains",
      "pattern": "docs/data-harness-spec\\.md"
    },
    {
      "id": "prompt_touch_package",
      "group": "prompt",
      "description": "创建或修改 mini_harness Python 包，或最终源码中存在该包",
      "method": "any_of",
      "checks": [
        {
          "method": "evidence_path_contains",
          "pattern": "mini_harness/|src/mini_harness/"
        },
        {
          "method": "file_exists",
          "path": "mini_harness/__init__.py"
        },
        {
          "method": "file_exists",
          "path": "mini_harness/runner.py"
        },
        {
          "method": "file_exists",
          "path": "src/mini_harness/__init__.py"
        },
        {
          "method": "file_exists",
          "path": "src/mini_harness/runner.py"
        }
      ]
    },
    {
      "id": "prompt_run_validation",
      "group": "prompt",
      "description": "用当前仓库内命令实际验证",
      "method": "evidence_command_matches",
      "pattern": "python\\s+-m\\s+mini_harness|python\\s+-c\\s+.*import\\s+mini_harness|pytest"
    },
    {
      "id": "spec_cli_runs",
      "group": "spec",
      "description": "固定 M1 命令能运行成功",
      "method": "command_exit_zero",
      "command": [
        "python",
        "-m",
        "mini_harness",
        "run",
        "data/input.csv",
        "data/events.jsonl",
        "--output",
        "tmp/report.json"
      ]
    },
    {
      "id": "spec_report_exists",
      "group": "spec",
      "description": "生成 tmp/report.json",
      "method": "file_exists",
      "path": "tmp/report.json"
    },
    {
      "id": "spec_report_valid_json",
      "group": "spec",
      "description": "报告是合法 JSON",
      "method": "json_valid",
      "path": "tmp/report.json"
    },
    {
      "id": "spec_report_fields",
      "group": "spec",
      "description": "报告包含必需字段",
      "method": "json_has_keys",
      "path": "tmp/report.json",
      "keys": [
        "processed_count",
        "rejected_count",
        "retry_count",
        "source_files"
      ]
    },
    {
      "id": "spec_expected_counts",
      "group": "spec",
      "description": "固定输入的 processed/rejected/retry 计数正确",
      "method": "json_values_equal",
      "path": "tmp/report.json",
      "values": {
        "processed_count": 4,
        "rejected_count": 2,
        "retry_count": 0
      }
    },
    {
      "id": "spec_source_files_order",
      "group": "spec",
      "description": "source_files 保持固定命令的输入顺序",
      "method": "json_values_equal",
      "path": "tmp/report.json",
      "values": {
        "source_files": [
          "data/input.csv",
          "data/events.jsonl"
        ]
      }
    },
    {
      "id": "spec_python_imports",
      "group": "spec",
      "description": "Python 导入入口可用",
      "method": "command_exit_zero",
      "command": [
        "python",
        "-c",
        "import mini_harness; from mini_harness.runner import run_dag, HarnessError; print(callable(run_dag), HarnessError.__name__)"
      ]
    },
    {
      "id": "agent_ran_cli_check",
      "group": "verification",
      "description": "agent 主动运行M1 CLI 验证命令",
      "method": "evidence_command_matches",
      "pattern": "python\\s+-m\\s+mini_harness\\s+run\\s+data/input\\.csv\\s+data/events\\.jsonl[\\s\\S]*--output\\s+\\S+"
    },
    {
      "id": "agent_cli_check_passed",
      "group": "verification",
      "description": "agent 主动运行的M1 CLI 验证命令通过",
      "method": "evidence_command_result_matches",
      "pattern": "python\\s+-m\\s+mini_harness\\s+run\\s+data/input\\.csv\\s+data/events\\.jsonl[\\s\\S]*--output\\s+\\S+"
    },
    {
      "id": "agent_ran_import_check",
      "group": "verification",
      "description": "agent 主动验证 Python import 入口（语义匹配，兼容 python -c/heredoc/脚本）",
      "method": "evidence_semantic_assert",
      "commands_must_have": [
        "python"
      ],
      "must_have": [
        "import\\s+mini_harness",
        "from\\s+mini_harness\\.runner\\s+import\\s+run_dag\\s*,\\s*HarnessError|from\\s+mini_harness\\.runner\\s+import\\s+HarnessError\\s*,\\s*run_dag"
      ]
    },
    {
      "id": "agent_import_check_passed",
      "group": "verification",
      "description": "agent 主动 Python import 验证命令成功（不要求固定输出文本）",
      "method": "evidence_semantic_assert",
      "commands_must_have": [
        "python"
      ],
      "must_have": [
        "import\\s+mini_harness",
        "from\\s+mini_harness\\.runner\\s+import\\s+run_dag\\s*,\\s*HarnessError|from\\s+mini_harness\\.runner\\s+import\\s+HarnessError\\s*,\\s*run_dag"
      ]
    },
    {
      "id": "rule_no_pip_install",
      "group": "rules",
      "description": "不运行 pip install",
      "method": "evidence_command_not_matches",
      "pattern": "\\bpip\\s+install\\b|python\\s+-m\\s+pip\\s+install\\b"
    },
    {
      "id": "rule_no_local_absolute_path",
      "group": "rules",
      "description": "不硬编码本机绝对路径",
      "method": "source_not_matches",
      "include": [
        "**/*.py",
        "**/*.md",
        "**/*.json",
        "**/*.toml",
        "**/*.yaml",
        "**/*.yml"
      ],
      "pattern": "[A-Za-z]:\\\\(?:Users|项目|\\w+)\\\\|/Users/[^/]+/|/home/[^/]+/"
    },
    {
      "id": "rule_local_validation",
      "group": "rules",
      "description": "使用仓库内本地命令验证",
      "method": "evidence_command_matches",
      "pattern": "python\\s+-m\\s+mini_harness|python\\s+-c\\s+.*import\\s+mini_harness|pytest"
    }
  ],
  "self_report_items": [
    {
      "item_id": "read_spec",
      "action_checks": [
        "prompt_read_spec"
      ],
      "effect_checks": [
        "prompt_read_spec"
      ],
      "verification_action_checks": [
        "prompt_read_spec"
      ],
      "verification_result_checks": [
        "prompt_read_spec"
      ]
    },
    {
      "item_id": "package_created",
      "action_checks": [
        "prompt_touch_package"
      ],
      "effect_checks": [
        "spec_python_imports"
      ],
      "verification_action_checks": [
        "agent_ran_import_check"
      ],
      "verification_result_checks": [
        "agent_import_check_passed"
      ]
    },
    {
      "item_id": "cli_report",
      "action_checks": [
        "prompt_touch_package"
      ],
      "effect_checks": [
        "spec_cli_runs",
        "spec_report_exists",
        "spec_report_valid_json",
        "spec_report_fields",
        "spec_expected_counts",
        "spec_source_files_order"
      ],
      "verification_action_checks": [
        "agent_ran_cli_check"
      ],
      "verification_result_checks": [
        "agent_cli_check_passed"
      ]
    },
    {
      "item_id": "python_imports",
      "action_checks": [
        "prompt_touch_package"
      ],
      "effect_checks": [
        "spec_python_imports"
      ],
      "verification_action_checks": [
        "agent_ran_import_check"
      ],
      "verification_result_checks": [
        "agent_import_check_passed"
      ]
    }
  ]
}
