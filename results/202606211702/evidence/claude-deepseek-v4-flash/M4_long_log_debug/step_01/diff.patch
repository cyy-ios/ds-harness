@@ -0,0 +1,87 @@
+"""Utility helpers — file I/O, snake_case, repo root detection."""
+
+import csv
+import json
+import os
+import re
+import subprocess
+from pathlib import Path
+
+
+def repo_root() -> Path:
+    """Return the absolute repository root path.
+
+    Uses ``git rev-parse --show-toplevel`` when available; falls back to
+    navigating up from this file's location (assumes ``mini_harness/`` sits
+    at the repo root).
+    """
+    try:
+        raw = subprocess.check_output(
+            ["git", "rev-parse", "--show-toplevel"],
+            stderr=subprocess.DEVNULL,
+        )
+        return Path(raw.decode().strip())
+    except (FileNotFoundError, subprocess.SubprocessError):
+        # Fallback: go up from mini_harness/utils.py → repo root
+        return Path(__file__).resolve().parent.parent
+
+import csv
+import json
+import re
+
+
+def to_snake_case(name: str) -> str:
+    """Convert a field name to snake_case.
+
+    Handles camelCase, PascalCase, spaces, and all-caps abbreviations.
+    Examples::
+
+        >>> to_snake_case("User Name")
+        'user_name'
+        >>> to_snake_case("eventType")
+        'event_type'
+        >>> to_snake_case("ID")
+        'id'
+        >>> to_snake_case("UserName")
+        'user_name'
+    """
+    # Insert underscore between lowercase/digit and uppercase: aB → a_B
+    name = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", name)
+    # Insert underscore between consecutive uppercase and uppercase+lowercase: ABc → A_Bc
+    name = re.sub(r"([A-Z])([A-Z][a-z])", r"\1_\2", name)
+    # Lower-case
+    name = name.lower()
+    # Replace non-alphanumeric runs with a single underscore
+    name = re.sub(r"[^a-z0-9_]", "_", name)
+    # Collapse multiple underscores and strip leading/trailing
+    name = re.sub(r"_+", "_", name).strip("_")
+    return name
+
+
+def read_csv(path: str) -> list[dict]:
+    """Read a CSV file, skipping comment and blank lines.
+
+    Returns a list of dicts keyed by the CSV header.
+    """
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        # Pre-process: drop comment/blank lines so csv.DictReader sees clean data
+        cleaned_lines = [
+            line for line in f
+            if line.strip() and not line.strip().startswith("#")
+        ]
+        if not cleaned_lines:
+            return []
+        reader = csv.DictReader(cleaned_lines)
+        return list(reader)
+
+
+def read_jsonl(path: str) -> list[dict]:
+    """Read a JSONL file, skipping blank lines."""
+    records: list[dict] = []
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            stripped = line.strip()
+            if not stripped:
+                continue
+            records.append(json.loads(stripped))
+    return records
