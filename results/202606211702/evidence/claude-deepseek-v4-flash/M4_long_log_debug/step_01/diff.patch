+"""DAG orchestrator — ``run_dag`` and ``HarnessError``.
+
+Public API required by skill::
+
+    from mini_harness.runner import run_dag, HarnessError
+"""
+
+import json
+import logging
+import os
+
+from mini_harness.stages import extract, clean, report
+
+logger = logging.getLogger(__name__)
+
+MAX_RETRIES = 2
+
+
+class HarnessError(Exception):
+    """Raised when a DAG stage fails after exhausting retries."""
+
+
+def _run_stage(name, fn, *args, **kwargs):
+    """Execute a stage function with up to ``MAX_RETRIES`` retries.
+
+    Returns ``(result, retried)`` where *result* is the stage's return value
+    and *retried* is the number of retries consumed (0 on first-try success).
+    """
+    retried = 0
+    for attempt in range(1, MAX_RETRIES + 2):  # 1 … 3  (initial + 2 retries)
+        try:
+            logger.info("attempt=%d stage=%s status=running", attempt, name)
+            result = fn(*args, **kwargs)
+            logger.info("attempt=%d stage=%s status=ok", attempt, name)
+            return result, retried
+        except Exception as exc:
+            logger.error(
+                "attempt=%d stage=%s status=failed error=%s",
+                attempt, name, exc,
+            )
+            if attempt <= MAX_RETRIES:
+                retried += 1
+            else:
+                raise HarnessError(
+                    f"Stage '{name}' failed after {attempt} attempts"
+                ) from exc
+
+
+def _persist_report(result, output_path):
+    """Write the report dict to disk (JSON)."""
+    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+    with open(output_path, "w", encoding="utf-8") as f:
+        json.dump(result, f, indent=2, ensure_ascii=False)
+
+
+def run_dag(sources: list[str], output_path: str) -> dict:
+    """Run the extract → clean → report DAG.
+
+    Parameters
+    ----------
+    sources:
+        One or more paths to input CSV/JSONL files.
+    output_path:
+        Destination for the JSON report.
+
+    Returns
+    -------
+    The report dict (also persisted to *output_path*).
+    """
+    source_files = [os.path.abspath(s) for s in sources]
+
+    # ---- extract ----
+    raw, retry_e = _run_stage("extract", extract, sources)
+
+    # ---- clean ----
+    (cleaned, rejects), retry_c = _run_stage("clean", clean, raw)
+
+    # ---- report ----
+    total_retries = retry_e + retry_c
+    result, retry_r = _run_stage(
+        "report", report,
+        cleaned, rejects, total_retries, source_files,
+    )
+    total_retries += retry_r
+
+    # Ensure retry_count in the produced report matches the real total
+    # (report() was called with total_retries before retry_r was known)
+    result["retry_count"] = total_retries
+
+    _persist_report(result, output_path)
+
+    logger.info(
+        "Report written to %s  (processed=%d rejected=%d retries=%d)",
+        output_path,
+        result["processed_count"],
+        result["rejected_count"],
+        result["retry_count"],
+    )
+    return result
