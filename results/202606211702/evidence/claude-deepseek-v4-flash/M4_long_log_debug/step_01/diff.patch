+"""Configuration loading — JSON and minimal-YAML support.
+
+Public helpers::
+
+    from mini_harness.config import load_config, find_config, merge_config
+"""
+
+import json
+import logging
+import os
+import re
+from pathlib import Path
+
+from mini_harness.utils import repo_root as _find_root
+
+logger = logging.getLogger(__name__)
+
+# Default config file names searched in order when ``--config`` is omitted
+DEFAULT_CONFIG_NAMES = ["config.json", "config.yaml", "config.yml"]
+
+
+# ---------------------------------------------------------------------------
+# Public API
+# ---------------------------------------------------------------------------
+
+def find_config(path: str | None = None) -> Path | None:
+    """Locate a config file.
+
+    If *path* is given it must exist (raises ``FileNotFoundError`` otherwise).
+    When *path* is ``None`` the first existing file from
+    ``DEFAULT_CONFIG_NAMES`` is returned (checked first in cwd, then in the
+    repo root), or ``None`` if none exist.
+    """
+    if path:
+        p = Path(path)
+        if not p.exists():
+            raise FileNotFoundError(f"Config file not found: {path}")
+        return p
+    # Check cwd first, then repo root
+    search_dirs = [Path.cwd()]
+    try:
+        search_dirs.append(_find_root())
+    except Exception:
+        pass
+    for name in DEFAULT_CONFIG_NAMES:
+        for d in dict.fromkeys(search_dirs):  # dedupe by insertion order
+            candidate = d / name
+            if candidate.exists():
+                logger.info("Using config file: %s", candidate)
+                return candidate
+    return None
+
+
+def load_config(config_path: Path) -> dict:
+    """Read a JSON or YAML config file and return the parsed dict."""
+    raw = config_path.read_text(encoding="utf-8-sig")
+    ext = config_path.suffix.lower()
+    if ext in (".yaml", ".yml"):
+        return _parse_yaml(raw)
+    # default: JSON (including .json)
+    return json.loads(raw)
+
+
+def merge_config(cli_args: dict, config: dict | None) -> dict:
+    """Merge CLI arguments (higher priority) over config values.
+
+    Returns a unified dict with ``sources`` and ``output`` keys.
+    """
+    merged = dict(config) if config else {}
+
+    # CLI positional sources override config sources
+    if cli_args.get("sources"):
+        merged["sources"] = cli_args["sources"]
+
+    # CLI --output overrides config output
+    if cli_args.get("output"):
+        merged["output"] = cli_args["output"]
+
+    return merged
+
+
+# ---------------------------------------------------------------------------
+# Minimal YAML parser
+# ---------------------------------------------------------------------------
+
+def _parse_yaml(text: str) -> dict:
+    """Parse a minimal YAML subset into a Python dict.
+
+    Supports:
+    - Top-level ``key: value`` mappings (including nested via indentation)
+    - Sequences (``- item``) as mapping values
+    - Scalar types: str, int, float, bool, None
+    - Single/double quoted strings
+    - Full-line and inline ``#`` comments
+    """
+    lines = _yaml_preprocess(text)
+    if not lines:
+        return {}
+    result, _ = _yaml_parse_map(lines, 0, 0)
+    return result if isinstance(result, dict) else {}
+
+
+def _yaml_preprocess(text: str) -> list[str]:
+    """Strip BOM, split lines, remove blank/comment-only lines."""
+    raw = text.lstrip("﻿")
+    out: list[str] = []
+    for line in raw.split("\n"):
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        out.append(line)
+    return out
+
+
+def _yaml_parse_map(
+    lines: list[str], start: int, base_indent: int,
+) -> tuple[dict | list, int]:
+    """Parse a YAML mapping or sequence from *start*.
+
+    Returns ``(result, next_line_idx)``.
+    """
+    result: dict = {}
+    i = start
+    in_sequence = False
+
+    while i < len(lines):
+        indent = _yaml_indent(lines[i])
+        if indent < base_indent:
+            break  # back to parent level
+        if indent > base_indent:
+            # Nested content — should not happen without a parent key;
+            # skip if we land here.
+            i += 1
+            continue
+
+        raw = lines[i].strip()
+
+        # --- Sequence item (- ) ---
+        if raw.startswith("- "):
+            in_sequence = True
+            seq, i = _yaml_parse_seq(lines, i, indent)
+            return seq, i
+
+        # --- Key: value ---
+        if ":" not in raw:
+            i += 1
+            continue
+
+        colon = raw.index(":")
+        key = raw[:colon].strip()
+        value_tail = raw[colon + 1:].strip()
+
+        if value_tail:
+            result[key] = _yaml_scalar(value_tail)
+            i += 1
+        else:
+            # Value is on the next line(s) at a deeper indent
+            i += 1
+            if i < len(lines) and _yaml_indent(lines[i]) > indent:
+                next_indent = _yaml_indent(lines[i])
+                if lines[i].strip().startswith("- "):
+                    result[key], i = _yaml_parse_seq(lines, i, next_indent)
+                else:
+                    sub, i = _yaml_parse_map(lines, i, next_indent)
+                    result[key] = sub
+            else:
+                # key: with no value = None
+                result[key] = None
+
+    return (result if not in_sequence else list(result.values())), i
+
+
+def _yaml_parse_seq(
+    lines: list[str], start: int, base_indent: int,
+) -> tuple[list, int]:
+    """Parse a YAML sequence starting at *start*."""
+    seq: list = []
+    i = start
+    while i < len(lines):
+        indent = _yaml_indent(lines[i])
+        if indent < base_indent:
+            break
+        raw = lines[i].strip()
+        if not raw.startswith("-"):
+            i += 1
+            continue
+        item_text = raw[1:].lstrip()
+        if item_text:
+            seq.append(_yaml_scalar(item_text))
+        else:
+            seq.append(None)
+        i += 1
+    return seq, i
+
+
+def _yaml_indent(line: str) -> int:
+    return len(line) - len(line.lstrip())
+
+
+def _yaml_scalar(value: str) -> object:
+    """Parse a scalar YAML value."""
+    v = value.strip()
+    if not v:
+        return None
+
+    # Strip inline comment (naive — does not handle ``#`` inside quotes)
+    # For config files this is sufficient.
+    if "#" in v:
+        # Check if hash is inside quotes
+        in_dq = in_sq = False
+        for i, ch in enumerate(v):
+            if ch == '"' and not in_sq:
+                in_dq = not in_dq
+            elif ch == "'" and not in_dq:
+                in_sq = not in_sq
+            elif ch == "#" and not in_dq and not in_sq:
+                v = v[:i].rstrip()
+                break
+
+    # Quoted strings
+    if len(v) >= 2 and v[0] == v[-1] and v[0] in ("'", '"'):
+        return v[1:-1]
+
+    # Booleans / null
+    low = v.lower()
+    if low in ("true", "yes", "on"):
+        return True
+    if low in ("false", "no", "off"):
+        return False
+    if low in ("null", "~"):
+        return None
+
+    # Numbers
+    try:
+        return int(v)
+    except ValueError:
+        pass
+    try:
+        return float(v)
+    except ValueError:
+        pass
+
+    return v
