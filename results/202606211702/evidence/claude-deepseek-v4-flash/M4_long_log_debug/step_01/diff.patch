+"""CLI entry-point — argparse-based run subcommand."""
+
+import argparse
+import logging
+import os
+import sys
+
+from mini_harness.config import find_config, load_config, merge_config
+from mini_harness.runner import run_dag, HarnessError
+from mini_harness.utils import repo_root
+
+logger = logging.getLogger(__name__)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    """Build argument parser with a ``run`` subcommand."""
+    parser = argparse.ArgumentParser(prog="mini_harness")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    run_p = sub.add_parser("run", help="Run the extract → clean → report DAG")
+    run_p.add_argument("sources", nargs="*", help="Input file(s) — CSV / JSONL")
+    run_p.add_argument(
+        "--config", "-c", default=None,
+        help="Path to JSON/YAML config file (default: search config.{json,yaml,yml})",
+    )
+    run_p.add_argument(
+        "--output", "-o", default=None,
+        help="Output report path (overrides config default)",
+    )
+    run_p.add_argument(
+        "--show-config", action="store_true",
+        help="Print resolved configuration and exit",
+    )
+
+    return parser
+
+
+def _resolve_run_args(args: argparse.Namespace) -> dict:
+    """Merge CLI args with optional config file; return unified ``run`` kwargs.
+
+    All relative paths are resolved against the repository root so that the
+    harness works from any working directory.
+    """
+    root = repo_root()
+
+    # Resolve --config relative to repo root (if not absolute)
+    config_arg = args.config
+    if config_arg and not os.path.isabs(config_arg):
+        config_arg = str(root / config_arg)
+
+    # Load config file (explicit or default)
+    config_path = find_config(config_arg)
+    config = load_config(config_path) if config_path else None
+
+    cli_dict: dict = {}
+    if args.sources:
+        cli_dict["sources"] = [
+            str(root / s) if not os.path.isabs(s) else s
+            for s in args.sources
+        ]
+    if args.output:
+        cli_dict["output"] = (
+            str(root / args.output) if not os.path.isabs(args.output)
+            else args.output
+        )
+
+    merged = merge_config(cli_dict, config)
+
+    # Resolve config-provided paths relative to repo root
+    if merged.get("sources"):
+        merged["sources"] = [
+            str(root / s) if not os.path.isabs(s) else s
+            for s in merged["sources"]
+        ]
+    if merged.get("output"):
+        if not os.path.isabs(merged["output"]):
+            merged["output"] = str(root / merged["output"])
+    else:
+        merged["output"] = str(root / "tmp/report.json")
+
+    merged.setdefault("sources", [])
+    return merged
+
+
+def main(argv: list[str] | None = None) -> None:
+    """CLI entry-point."""
+    logging.basicConfig(
+        level=logging.INFO,
+        format="%(asctime)s [%(levelname)s] %(message)s",
+        datefmt="%H:%M:%S",
+        force=True,
+    )
+    parser = build_parser()
+    args = parser.parse_args(argv)
+
+    if args.command == "run":
+        try:
+            cfg = _resolve_run_args(args)
+        except FileNotFoundError as exc:
+            logger.error("Config error: %s", exc)
+            sys.exit(1)
+
+        if args.show_config:
+            print("Resolved config:")
+            for k, v in cfg.items():
+                print(f"  {k}: {v}")
+            return
+
+        if not cfg["sources"]:
+            logger.error(
+                "No source files specified. Provide positional args or a config file."
+            )
+            sys.exit(1)
+
+        try:
+            result = run_dag(cfg["sources"], cfg["output"])
+            print(f"Report written to {cfg['output']}")
+            print(f"  processed: {result['processed_count']}, "
+                  f"rejected: {result['rejected_count']}, "
+                  f"retries: {result['retry_count']}")
+        except HarnessError as exc:
+            logger.error("Harness failed: %s", exc)
+            sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
