+"""Report module — produces the final summary dict.
+
+The report includes processed/rejected counts, retry info, source file
+references, and a mandatory citation of ``memory/memory_summary.md`` as
+required by the data-harness skill.
+"""
+
+import logging
+
+logger = logging.getLogger(__name__)
+
+MEMORY_REFERENCE = "memory/memory_summary.md"
+
+
+def build_report(
+    cleaned: list[dict],
+    rejects: list[dict],
+    retry_count: int,
+    source_files: list[str],
+) -> dict:
+    """Build the final report dict.
+
+    Parameters
+    ----------
+    cleaned:
+        Records that passed the clean stage.
+    rejects:
+        Records that failed the clean stage.
+    retry_count:
+        Total number of retries across all DAG stages.
+    source_files:
+        Absolute paths of input source files.
+
+    Returns
+    -------
+    A dict with fields ``processed_count``, ``rejected_count``,
+    ``retry_count``, ``source_files``, and ``memory_reference``.
+    """
+    report = {
+        "processed_count": len(cleaned),
+        "rejected_count": len(rejects),
+        "retry_count": retry_count,
+        "source_files": source_files,
+        "memory_reference": MEMORY_REFERENCE,
+    }
+    logger.info(
+        "Report built: processed=%d rejected=%d retries=%d",
+        len(cleaned), len(rejects), retry_count,
+    )
+    return report
