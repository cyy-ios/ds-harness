+"""CLI for mini_harness using argparse."""
+import argparse
+import sys
+
+from mini_harness.runner import run_dag, HarnessError
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="mini_harness")
+    subparsers = parser.add_subparsers(dest="command")
+
+    run_parser = subparsers.add_parser("run", help="Run the data processing DAG")
+    run_parser.add_argument("inputs", nargs="+", help="Input files (CSV or JSONL)")
+    run_parser.add_argument("--output", "-o", required=True, help="Output report path")
+
+    args = parser.parse_args(argv)
+
+    if args.command == "run":
+        try:
+            report = run_dag(args.inputs, args.output)
+            print(report)
+        except HarnessError as e:
+            print(f"Error: {e}", file=sys.stderr)
+            sys.exit(1)
+    else:
+        parser.print_help()
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
