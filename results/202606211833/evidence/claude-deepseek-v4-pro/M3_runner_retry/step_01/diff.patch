+"""CLI for mini_harness using argparse."""
+import argparse
+import sys
+
+from mini_harness.config import load_config
+from mini_harness.runner import run_dag, HarnessError
+
+
+def _merge_config_with_args(args: argparse.Namespace) -> tuple[list[str], str]:
+    """Resolve inputs and output by merging config file with CLI args.
+
+    CLI args always take precedence over config values.
+    """
+    cfg = load_config(args.config)
+    sources = args.inputs or cfg.get("sources", [])
+    output = args.output or cfg.get("output", "")
+    return sources, output
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="mini_harness")
+    subparsers = parser.add_subparsers(dest="command")
+
+    run_parser = subparsers.add_parser("run", help="Run the data processing DAG")
+    run_parser.add_argument("inputs", nargs="*", help="Input files (CSV or JSONL)")
+    run_parser.add_argument("--output", "-o", default="", help="Output report path")
+    run_parser.add_argument(
+        "--config", "-c", default=None,
+        help="Config file path (JSON or YAML).  If omitted, scans for mini_harness-config.{json,yaml,yml}",
+    )
+
+    args = parser.parse_args(argv)
+
+    if args.command == "run":
+        sources, output = _merge_config_with_args(args)
+        if not sources:
+            print("Error: no input sources specified (provide as CLI args or in config)", file=sys.stderr)
+            sys.exit(1)
+        if not output:
+            print("Error: no output path specified (provide via --output or in config)", file=sys.stderr)
+            sys.exit(1)
+        try:
+            report = run_dag(sources, output)
+            print(report)
+        except HarnessError as e:
+            print(f"Error: {e}", file=sys.stderr)
+            sys.exit(1)
+    else:
+        parser.print_help()
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
