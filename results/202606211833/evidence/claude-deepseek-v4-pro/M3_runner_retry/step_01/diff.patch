@@ -0,0 +1,94 @@
+"""DAG runner with retry logic for extract → clean → report pipeline."""
+import json
+import logging
+import os
+import sys
+from typing import Any
+
+from mini_harness.extract import extract
+from mini_harness.clean import clean
+from mini_harness.report import generate_report
+
+logger = logging.getLogger("mini_harness")
+logger.setLevel(logging.INFO)
+if not logger.handlers:
+    _h = logging.StreamHandler(sys.stderr)
+    _h.setFormatter(logging.Formatter("%(asctime)s [%(name)s] %(message)s"))
+    logger.addHandler(_h)
+
+# Ensure memory/ directory reference — see memory/memory_summary.md for design decisions.
+MEMORY_SUMMARY_PATH = os.path.join(os.path.dirname(__file__), "..", "memory", "memory_summary.md")
+
+
+class HarnessError(Exception):
+    """Custom error for harness failures."""
+
+
+def _log_attempt(attempt: int, stage: str, status: str):
+    """Emit a structured log line with attempt, stage, and status."""
+    logger.info(json.dumps({"attempt": attempt, "stage": stage, "status": status}))
+
+
+def _run_dag_with_retry(stage_name: str, fn, *args, **kwargs):
+    """Run a DAG stage with up to 2 retries on failure.
+
+    Returns (result, retry_count).
+    """
+    max_retries = 2
+    retries = 0
+    for attempt_num in range(1, max_retries + 2):  # 1 initial + up to 2 retries
+        try:
+            _log_attempt(attempt_num, stage_name, "running")
+            result = fn(*args, **kwargs)
+            _log_attempt(attempt_num, stage_name, "ok")
+            return result, retries
+        except Exception as e:
+            retries += 1
+            _log_attempt(attempt_num, stage_name, "failed")
+            logger.warning("stage=%s attempt=%d error=%s", stage_name, attempt_num, e)
+            if attempt_num > max_retries:
+                raise HarnessError(
+                    f"Stage '{stage_name}' failed after {max_retries} retries"
+                ) from e
+    raise HarnessError(f"Stage '{stage_name}' failed")  # unreachable
+
+
+def _write_rejects(rejects: list[dict[str, Any]], output_dir: str):
+    """Write rejected records to a sidecar JSON file for inspection."""
+    rejects_path = os.path.join(output_dir, "rejects.json")
+    with open(rejects_path, "w", encoding="utf-8") as f:
+        json.dump(rejects, f, indent=2, ensure_ascii=False)
+    logger.info("rejects written to %s", rejects_path)
+
+
+def run_dag(input_paths: list[str], output_path: str) -> dict[str, Any]:
+    """Run the full extract → clean → report DAG.
+
+    Returns the report dict.
+    """
+    total_retries = 0
+
+    # Stage 1: Extract
+    all_records = []
+    for fp in input_paths:
+        records, r = _run_dag_with_retry("extract", extract, fp)
+        total_retries += r
+        all_records.extend(records)
+
+    # Stage 2: Clean
+    clean_result, r = _run_dag_with_retry("clean", clean, all_records)
+    total_retries += r
+    cleaned, rejects = clean_result
+
+    # Stage 3: Report
+    output_dir = os.path.dirname(output_path) or "."
+    os.makedirs(output_dir, exist_ok=True)
+    if rejects:
+        _write_rejects(rejects, output_dir)
+    report_result, r = _run_dag_with_retry(
+        "report", generate_report, cleaned, rejects, total_retries, input_paths, output_path
+    )
+    total_retries += r
+    report = report_result
+
+    return report
