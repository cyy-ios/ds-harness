+"""Clean stage: normalise field names, filter rejects, remove empty rows."""
+import re
+from typing import Any
+
+
+def to_snake_case(name: str) -> str:
+    """Convert a string to snake_case."""
+    s = re.sub(r"[\s\-]+", "_", name.strip())
+    s = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", s)
+    s = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1_\2", s)
+    return s.lower()
+
+
+def clean(records: list[dict[str, Any]]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+    """Clean records: snake_case keys, drop empty rows, split out records missing 'id'.
+
+    Returns (cleaned, rejects).
+    """
+    cleaned = []
+    rejects = []
+    for rec in records:
+        # Remove completely empty rows
+        if all(v is None or (isinstance(v, str) and v.strip() == "") or (isinstance(v, list) and len(v) == 0) for v in rec.values()):
+            continue
+
+        # Convert field names to snake_case
+        row = {to_snake_case(k): v for k, v in rec.items()}
+
+        # Records missing 'id' go to rejects
+        if "id" not in row or row["id"] is None or (isinstance(row["id"], str) and row["id"].strip() == ""):
+            rejects.append(row)
+        else:
+            cleaned.append(row)
+    return cleaned, rejects
