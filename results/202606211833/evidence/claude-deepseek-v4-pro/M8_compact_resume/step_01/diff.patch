@@ -0,0 +1,131 @@
+"""Config loader: JSON and minimal YAML parsing for mini_harness config files.
+
+Supported config keys: sources (list of input paths), output (report path).
+"""
+import json
+import os
+from typing import Any
+
+
+# Conventional default config filenames scanned in CWD when no --config is given.
+DEFAULT_CONFIG_NAMES = [
+    "mini_harness-config.json",
+    "mini_harness-config.yaml",
+    "mini_harness-config.yml",
+]
+
+# Config keys we recognise.
+KNOWN_KEYS = {"sources", "output"}
+
+
+def _load_json(path: str) -> dict[str, Any]:
+    """Load and validate a JSON config file."""
+    with open(path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+    if not isinstance(data, dict):
+        raise ValueError(f"Config file {path}: top-level must be a JSON object")
+    return _filter_known(data)
+
+
+def _load_yaml(path: str) -> dict[str, Any]:
+    """Load a YAML config file with a minimal built-in parser.
+
+    Handles simple mappings, scalars, and list items — sufficient for
+    mini_harness config files.  Does not handle block scalars, anchors,
+    or complex nesting.
+    """
+    with open(path, "r", encoding="utf-8") as f:
+        lines = f.readlines()
+
+    result: dict[str, Any] = {}
+    current_key: str | None = None
+    current_list: list[str] = []
+
+    def _flush():
+        nonlocal current_key, current_list
+        if current_key is not None:
+            result[current_key] = current_list if current_list else result.get(current_key)
+            current_key = None
+            current_list = []
+
+    for raw in lines:
+        line = raw.rstrip("\n\r")
+        # Skip blank lines and full-line comments
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+
+        # List item (must be under a mapping key)
+        list_match = stripped.startswith("- ")
+        if list_match:
+            if current_key is None:
+                raise ValueError(f"YAML list item without parent key in {path}: {stripped}")
+            current_list.append(stripped[2:].strip())
+            continue
+
+        # inline comment removal — only outside quoted strings
+        if "#" in stripped:
+            # Simple heuristic: split on ' #' that isn't inside quotes
+            for i, ch in enumerate(stripped):
+                if ch == "#" and i > 0 and stripped[i - 1] == " ":
+                    in_quotes = False
+                    for j in range(i):
+                        if stripped[j] in ('"', "'"):
+                            in_quotes = not in_quotes
+                    if not in_quotes:
+                        stripped = stripped[:i].rstrip()
+                        break
+
+        if ":" not in stripped:
+            continue
+
+        _flush()
+        key, _, value = stripped.partition(":")
+        key = key.strip()
+        value = value.strip()
+
+        if value:
+            # Scalar value
+            result[key] = value
+            current_key = None
+        else:
+            # Start of a mapping/list block
+            current_key = key
+
+    _flush()
+    return _filter_known(result)
+
+
+def _filter_known(data: dict[str, Any]) -> dict[str, Any]:
+    """Keep only known config keys."""
+    return {k: v for k, v in data.items() if k in KNOWN_KEYS}
+
+
+def _find_default_config() -> str | None:
+    """Return the first default config file found in CWD, or None."""
+    cwd = os.getcwd()
+    for name in DEFAULT_CONFIG_NAMES:
+        path = os.path.join(cwd, name)
+        if os.path.isfile(path):
+            return path
+    return None
+
+
+def load_config(path: str | None = None) -> dict[str, Any]:
+    """Load configuration from a JSON or YAML file.
+
+    If *path* is None, scans CWD for conventional default config files.
+    Returns a dict with zero or more of: sources, output.
+    """
+    if path is None:
+        path = _find_default_config()
+        if path is None:
+            return {}
+
+    ext = os.path.splitext(path)[1].lower()
+    if ext in (".yaml", ".yml"):
+        return _load_yaml(path)
+    elif ext == ".json":
+        return _load_json(path)
+    else:
+        raise ValueError(f"Unsupported config format: {ext} (expected .json, .yaml, or .yml)")
