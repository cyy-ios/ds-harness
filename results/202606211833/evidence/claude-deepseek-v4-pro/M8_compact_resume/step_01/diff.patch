@@ -0,0 +1,40 @@
+"""Extract stage: read CSV and JSONL files into raw records."""
+import csv
+import json
+import os
+from typing import Any
+
+
+def extract_csv(filepath: str) -> list[dict[str, Any]]:
+    """Extract records from a CSV file, skipping #-comment and blank lines."""
+    records = []
+    with open(filepath, "r", encoding="utf-8", newline="") as f:
+        # Pre-filter: strip lines that start with # (comment) or are blank.
+        # csv.DictReader does not natively skip comment lines.
+        filtered = (line for line in f if line.strip() and not line.lstrip().startswith("#"))
+        reader = csv.DictReader(filtered)
+        for row in reader:
+            records.append(dict(row))
+    return records
+
+
+def extract_jsonl(filepath: str) -> list[dict[str, Any]]:
+    """Extract records from a JSONL file."""
+    records = []
+    with open(filepath, "r", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                records.append(json.loads(line))
+    return records
+
+
+def extract(filepath: str) -> list[dict[str, Any]]:
+    """Extract records from a file, dispatching on extension."""
+    ext = os.path.splitext(filepath)[1].lower()
+    if ext == ".csv":
+        return extract_csv(filepath)
+    elif ext in (".jsonl", ".json"):
+        return extract_jsonl(filepath)
+    else:
+        raise ValueError(f"Unsupported file format: {ext}")
