+"""Workbench entry point — redirects to root mini_harness via importlib.
+
+Makes ``python -m mini_harness run`` work from ``subdir/workbench/`` without
+duplicating the real package.
+"""
+import importlib.util
+import os
+import sys
+
+_repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".."))
+
+
+def _import_module_from_path(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault(name, mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def main():
+    # Load root mini_harness modules via file paths, bypassing shim namespace
+    _import_module_from_path("mini_harness", os.path.join(_repo_root, "mini_harness", "__init__.py"))
+    # Load the CLI module — it will re-import mini_harness.* as usual, but
+    # we've already registered the root mini_harness in sys.modules, so the
+    # shim is transparent.
+    for sub in ("config", "extract", "clean", "report", "runner"):
+        _import_module_from_path(f"mini_harness.{sub}", os.path.join(_repo_root, "mini_harness", f"{sub}.py"))
+    _import_module_from_path("mini_harness.cli", os.path.join(_repo_root, "mini_harness", "cli.py"))
+
+    # Now invoke the main CLI
+    from mini_harness.cli import main as cli_main
+    cli_main()
+
+
+if __name__ == "__main__":
+    main()
