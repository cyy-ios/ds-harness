+"""Workbench shim — redirects all mini_harness imports to the root package.
+
+When CWD is ``subdir/workbench/``, Python finds this shim first.  We inject
+the repo root into sys.path and load the real mini_harness modules from there.
+"""
+import importlib
+import importlib.util
+import os
+import sys
+
+_repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".."))
+_subs = ("config", "extract", "clean", "report", "runner", "cli")
+
+
+def _load_root_module(name):
+    """Import the real mini_harness submodule from the repo root."""
+    fp = os.path.join(_repo_root, "mini_harness", f"{name.split('.')[-1]}.py")
+    if not os.path.isfile(fp):
+        return None
+    spec = importlib.util.spec_from_file_location(name, fp)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+# Pre-load all root submodules into sys.modules so that
+# ``from mini_harness.runner import run_dag`` finds the real ones.
+for _sub in _subs:
+    _fq = f"mini_harness.{_sub}"
+    if _fq not in sys.modules:
+        _m = _load_root_module(_fq)
+        if _m is not None:
+            sys.modules[_fq] = _m
