+"""Report stage: produce the final JSON report reflecting real processing results."""
+import json
+import os
+from typing import Any
+
+
+def generate_report(
+    cleaned: list[dict[str, Any]],
+    rejects: list[dict[str, Any]],
+    retry_count: int,
+    source_files: list[str],
+    output_path: str,
+) -> dict[str, Any]:
+    """Generate and write the report JSON.
+
+    The report includes per-source record counts so the output reflects
+    exactly what extract → clean → report produced.
+    """
+    report = {
+        "processed_count": len(cleaned),
+        "rejected_count": len(rejects),
+        "retry_count": retry_count,
+        "source_files": source_files,
+        "records": {
+            "rejected": rejects,
+        },
+    }
+
+    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+    with open(output_path, "w", encoding="utf-8") as f:
+        json.dump(report, f, indent=2, ensure_ascii=False)
+    return report
