++{"milestone": "M2_config", "step": 54, "tool": "command_execution", "tool_output": "\"\"\"mini_harness - Mini data processing harness.\"\"\"\r\nfrom mini_harness.runner import run_dag, HarnessError\r\n__all__ = [\"run_dag\", \"HarnessError\"]\r\n=====\r\nfrom mini_harness.cli import main\r\nmain()\r\n=====\r\n\"\"\"CLI for mini_harness using argparse only.\"\"\"\r\nimport argparse\r\nimport sys\r\nfrom pathlib import Path\r\nfrom mini_harness.runner import run_dag, HarnessError\r\nfrom mini_harness.config import load_config, ConfigError\r\n\r\n\r\ndef main(argv=None):\r\n    parser = argparse.ArgumentParser(prog=\"mini_harness\")\r\n    sub = parser.add_subparsers(dest=\"command\")\r\n\r\n    run_parser = sub.add_parser(\"run\", help=\"Run the data processing DAG\")\r\n    run_parser.add_argument(\"inputs\", nargs=\"*\", help=\"Input files (CSV or JSONL)\")\r\n    run_parser.add_argument(\"--output\", default=None, help=\"Output report path\")\r\n    run_parser.add_argument(\"--config\", default=None, help=\"Config file path (JSON or YAML)\")\r\n\r\n    args = parser.parse_args(argv)\r\n\r\n    if args.command != \"run\":\r\n        parser.print_help()\r\n        sys.exit(1)\r\n\r\n    repo_root = Path(__file__).resolve().parent.parent\r\n\r\n    try:\r\n        cfg = load_config(str(repo_root), args.config)\r\n    except ConfigError as e:\r\n        print(f\"ERROR: {e}\", file=sys.stderr)\r\n        sys.exit(1)\r\n\r\n    # CLI overrides config; config fills defaults\r\n    from mini_harness.config import resolve_path\r\n\r\n    inputs = args.inputs if args.inputs else cfg.get(\"inputs\", [])\r\n    if not inputs:\r\n        print(\"ERROR: no input files specified (use CLI args or config)\", file=sys.stderr)\r\n        sys.exit(1)\r\n    inputs = [resolve_path(repo_root, p) for p in inputs]\r\n\r\n    output = args.output or cfg.get(\"output\")\r\n    if not output:\r\n        print(\"ERROR: --output required (or set in config)\", file=sys.stderr)\r\n        sys.exit(1)\r\n    output = resolve_path(repo_root, output)\r\n\r\n    max_retries = cfg.get(\"max_retries\", 2)\r\n    log_dir = resolve_path(repo_root, cfg.get(\"log_dir\", \"logs\"))\r\n\r\n    try:\r\n        report = run_dag(inputs, output, repo_root=str(repo_root),\r\n                         max_retries=max_retries, log_dir=log_dir)\r\n        print(f\"Report written to {report}\")\r\n    except HarnessError as e:\r\n        print(f\"ERROR: {e}\", file=sys.stderr)\r\n        sys.exit(1)\r\n    return 0\r\n=====\r\n\"\"\"Configuration loader for mini_harness: JSON and minimal YAML.\"\"\"\r\n\r\nimport json\r\nimport re\r\nfrom pathlib import Path\r\n\r\n\r\nDEFAULT_CONFIG_NAMES = (\"config.yaml\", \"config.yml\", \"config.json\")\r\nDEFAULT_CONFIG = {\r\n    \"max_retries\": 2,\r\n    \"log_dir\": \"logs\",\r\n}\r\n\r\n\r\nclass ConfigError(Exception):\r\n    \"\"\"Raised when config file cannot be parsed.\"\"\"\r\n\r\n\r\n# ----- minimal YAML parser (std lib only) -----\r\n\r\ndef _parse_yaml(text):\r\n    \"\"\"Parse a minimal YAML subset: scalars, sequences, mappings, comments.\"\"\"\r\n    lines = text.splitlines()\r\n    root = {}\r\n    ctx = [(root, -1, None)]\r\n    current_seq = None\r\n\r\n    for lineno, raw in enumerate(lines, 1):\r\n        stripped = raw.rstrip()\r\n        if not stripped or stripped.lstrip().startswith(\"#\"):\r\n            continue\r\n\r\n        indent = len(raw) - len(raw.lstrip())\r\n        line = stripped\r\n\r\n        # pop context to current indent level\r\n        while ctx and indent <= ctx[-1][1]:\r\n            _resolve_pending(ctx)\r\n            ctx.pop()\r\n            current_seq = None\r\n\r\n        if not ctx:\r\n            ctx = [(root, -1, None)]\r\n\r\n        parent, _, pending_key = ctx[-1]\r\n\r\n        # sequence item: \"- value\"\r\n        if line.lstrip().startswith(\"- \"):\r\n            seq_val = line.lstrip()[2:].strip()\r\n            if pending_key is not None:\r\n                _resolve_pending_as_list(ctx)\r\n                parent = ctx[-1][0]\r\n                current_seq = parent\r\n            if current_seq is None:\r\n                raise ConfigError(f\"Line {lineno}: sequence item outside mapping key\")\r\n            if seq_val == \"\":\r\n                child = {}\r\n                current_seq.append(child)\r\n                ctx.append((child, indent, None))\r\n            else:\r\n                current_seq.append(_parse_yaml_scalar(seq_val))\r\n            continue\r\n\r\n        # mapping key: \"key: value\" or \"key:\"\r\n        m = re.match(r\"^([^:]+?):(?:\\s+(.*))?$\", line)\r\n        if not m:\r\n            raise ConfigError(f\"Line {lineno}: invalid YAML line: {line!r}\")\r\n\r\n        key = m.group(1).strip()\r\n        raw_val = (m.group(2) or \"\").strip()\r\n\r\n        _resolve_pending(ctx)\r\n\r\n        if isinstance(parent, list):\r\n            raise ConfigError(f\"Line {lineno}: cannot nest mapping key under sequence\")\r\n\r\n        if raw_val == \"\":\r\n            ctx.append((parent, indent, key))\r\n            current_seq = None\r\n        elif raw_val == \"[]\":\r\n            parent[key] = []\r\n            current_seq = parent[key]\r\n            ctx.append((parent, indent, None))\r\n        else:\r\n            parent[key] = _parse_yaml_scalar(raw_val)\r\n            current_seq = None\r\n\r\n    for _ in range(len(ctx)):\r\n        _resolve_pending(ctx)\r\n\r\n    return root\r\n\r\n\r\ndef _resolve_pending(ctx):\r\n    \"\"\"If the top of stack has a pending key, resolve it as an empty mapping.\"\"\"\r\n    if ctx and ctx[-1][2] is not None:\r\n        parent, indent, key = ctx[-1]\r\n        ctx[-1] = (parent, indent, None)\r\n        parent[key] = {}\r\n\r\n\r\ndef _resolve_pending_as_list(ctx):\r\n    \"\"\"Convert the top-of-stack pending key to a list.\"\"\"\r\n    if ctx and ctx[-1][2] is not None:\r\n        parent, indent, key = ctx[-1]\r\n        lst = []\r\n        parent[key] = lst\r\n        ctx[-1] = (lst, indent, None)\r\n\r\n\r\ndef _parse_yaml_scalar(s):\r\n    \"\"\"Parse a YAML scalar: null, bool, int, float, string.\"\"\"\r\n    s = s.strip()\r\n    if s in (\"null\", \"~\", \"\"):\r\n        return None\r\n    if s in (\"true\", \"True\", \"TRUE\"):\r\n        return True\r\n    if s in (\"false\", \"False\", \"FALSE\"):\r\n        return False\r\n    try:\r\n        if \".\" in s or \"e\" in s.lower():\r\n            return float(s)\r\n        return int(s)\r\n    except ValueError:\r\n        pass\r\n    if (s.startswith('\"') and s.endswith('\"')) or (s.startswith(\"'\") and s.endswith(\"'\")):\r\n        return s[1:-1]\r\n    return s\r\n\r\n\r\n# ----- public API -----\r\n\r\ndef find_config(repo_root, explicit_path=None):\r\n    \"\"\"Resolve config path: explicit > defaults in repo_root.\"\"\"\r\n    root = Path(repo_root)\r\n    if explicit_path:\r\n        p = Path(explicit_path)\r\n        if not p.is_absolute():\r\n            p = root / p\r\n        if p.exists():\r\n            return p\r\n        raise ConfigError(f\"Config file not found: {p}\")\r\n    for name in DEFAULT_CONFIG_NAMES:\r\n        p = root / name\r\n        if p.exists():\r\n            return p\r\n    return None\r\n\r\n\r\ndef load_config(repo_root, explicit_path=None):\r\n    \"\"\"Load configuration, merging with defaults.\r\n\r\n    Returns a dict with at least: max_retries, log_dir.\r\n    \"\"\"\r\n    cfg = dict(DEFAULT_CONFIG)\r\n    path = find_config(repo_root, explicit_path)\r\n    if path is None:\r\n        return cfg\r\n\r\n    text = path.read_text(encoding=\"utf-8\")\r\n    # strip BOM if present\r\n    if text and text[0] == \"\\ufeff\":\r\n        text = text[1:]\r\n\r\n    if path.suffix in (\".yaml\", \".yml\"):\r\n        parsed = _parse_yaml(text)\r\n    else:\r\n        parsed = json.loads(text)\r\n\r\n    if not isinstance(parsed, dict):\r\n        raise ConfigError(f\"Config must be a mapping, got {type(parsed).__name__}\")\r\n\r\n    cfg.update({k: v for k, v in parsed.items() if k in DEFAULT_CONFIG or k in (\"inputs\", \"output\")})\r\n    return cfg\r\n\r\n\r\ndef resolve_path(repo_root, p):\r\n    \"\"\"Return absolute path: if relative, join with repo_root.\"\"\"\r\n    p = Path(p)\r\n    if p.is_absolute():\r\n        return str(p)\r\n    return str(Path(repo_root) / p)\r\n=====\r\n\"\"\"DAG runner: extract -> clean -> report, with retry and logging.\"\"\"\r\nimport csv\r\nimport json\r\nimport logging\r\nimport re\r\nfrom pathlib import Path\r\n\r\n\r\nclass HarnessError(Exception):\r\n    \"\"\"Raised for harness-level failures.\"\"\"\r\n\r\n\r\ndef _to_snake_case(name):\r\n    s1 = re.sub(r\"([A-Z]+)([A-Z][a-z])\", r\"\\1_\\2\", name)\r\n    s2 = re.sub(r\"([a-z\\d])([A-Z])\", r\"\\1_\\2\", s1)\r\n    s3 = re.sub(r\"[-\\s]+\", \"_\", s2)\r\n    return s3.lower().strip(\"_\")\r\n\r\n\r\ndef _extract_csv(path):\r\n    records = []\r\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\r\n        reader = csv.DictReader(f)\r\n        for row in reader:\r\n            records.append({k: v for k, v in row.items() if k is not None})\r\n    return records\r\n\r\n\r\ndef _extract_jsonl(path):\r\n    records = []\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        for line in f:\r\n            line = line.strip()\r\n            if line:\r\n                records.append(json.loads(line))\r\n    return records\r\n\r\n\r\ndef _extract(inputs):\r\n    all_records = []\r\n    for path in inputs:\r\n        p = Path(path)\r\n        if p.suffix == \".csv\":\r\n            all_records.extend(_extract_csv(str(p)))\r\n        elif p.suffix == \".jsonl\":\r\n            all_records.extend(_extract_jsonl(str(p)))\r\n        else:\r\n            raise HarnessError(f\"Unsupported file type: {path}\")\r\n    return all_records\r\n\r\n\r\ndef _clean(records):\r\n    processed = []\r\n    rejects = []\r\n    for rec in records:\r\n        if all(v is None or str(v).strip() == \"\" for v in rec.values()):\r\n            continue\r\n        cleaned = {_to_snake_case(k): v for k, v in rec.items()}\r\n        if \"id\" not in cleaned or cleaned[\"id\"] is None or str(cleaned[\"id\"]).strip() == \"\":\r\n            rejects.append(cleaned)\r\n        else:\r\n            processed.append(cleaned)\r\n    return processed, rejects\r\n\r\n\r\ndef _report(processed, rejects, retry_count, source_files, output_path):\r\n    report = {\r\n        \"processed_count\": len(processed),\r\n        \"rejected_count\": len(rejects),\r\n        \"retry_count\": retry_count,\r\n        \"source_files\": source_files,\r\n    }\r\n    out = Path(output_path)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    with open(out, \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(report, f, indent=2)\r\n    return str(out)\r\n\r\n\r\ndef _setup_logging(log_dir):\r\n    log_dir = Path(log_dir)\r\n    log_dir.mkdir(parents=True, exist_ok=True)\r\n    log_path = log_dir / \"dag.log\"\r\n    logger = logging.getLogger(\"mini_harness\")\r\n    logger.setLevel(logging.DEBUG)\r\n    logger.handlers.clear()\r\n    fh = logging.FileHandler(str(log_path), encoding=\"utf-8\")\r\n    fh.setLevel(logging.DEBUG)\r\n    fh.setFormatter(logging.Formatter(\"%(asctime)s %(levelname)s %(message)s\"))\r\n    logger.addHandler(fh)\r\n    return logger\r\n\r\n\r\ndef run_dag(inputs, output, repo_root=None, max_retries=2, log_dir=None):\r\n    if repo_root is None:\r\n        repo_root = str(Path(__file__).resolve().parent.parent)\r\n    repo = Path(repo_root)\r\n\r\n    if log_dir is None:\r\n        log_dir = str(repo / \"logs\")\r\n\r\n    logger = _setup_logging(log_dir)\r\n    total_retries = 0\r\n\r\n    raw_records = None\r\n    processed = None\r\n    rejects = None\r\n\r\n    for stage_name in (\"extract\", \"clean\", \"report\"):\r\n        attempt = 1\r\n        last_error = None\r\n\r\n        while attempt <= max_retries + 1:\r\n            try:\r\n                if stage_name == \"extract\":\r\n                    raw_records = _extract(inputs)\r\n                elif stage_name == \"clean\":\r\n                    if raw_records is None:\r\n                        raise HarnessError(\"extract must run before clean\")\r\n                    processed, rejects = _clean(raw_records)\r\n                elif stage_name == \"report\":\r\n                    if processed is None:\r\n                        raise HarnessError(\"clean must run before report\")\r\n                    result = _report(processed, rejects, total_retries, inputs, output)\r\n                    logger.info(\"attempt=%d stage=%s status=ok\", attempt, stage_name)\r\n                    return result\r\n\r\n                logger.info(\"attempt=%d stage=%s status=ok\", attempt, stage_name)\r\n                break\r\n            except Exception as e:\r\n                last_error = e\r\n                if attempt <= max_retries:\r\n                    logger.warning(\r\n                        \"attempt=%d stage=%s status=retry error=%s\",\r\n                        attempt, stage_name, e,\r\n                    )\r\n                else:\r\n                    logger.error(\r\n                        \"attempt=%d stage=%s status=fail error=%s\",\r\n                        attempt, stage_name, e,\r\n                    )\r\n                attempt += 1\r\n                total_retries += 1\r\n        else:\r\n            raise HarnessError(\r\n                f\"Stage '{stage_name}' failed after {max_retries} retries: {last_error}\"\r\n            )\r\n\r\n    return None\r\n", "tool_error": false, "event_type": "tool_result", "event_id": "item_28"}
