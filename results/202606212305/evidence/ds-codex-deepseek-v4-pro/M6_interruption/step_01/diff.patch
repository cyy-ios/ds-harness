+import json
+from pathlib import Path
+from mini_harness.runner import run_dag, HarnessError
+from mini_harness.config import load_config
+
+REPO = Path(__file__).resolve().parent.parent.parent.parent
+
+def test_imports_and_config_from_subdir():
+    """mini_harness importable; auto-discovered config works."""
+    cfg = load_config(str(REPO))
+    # config.yaml in repo root has max_retries=3, log_dir=custom_logs
+    assert cfg["max_retries"] == 3
+    assert cfg["log_dir"] == "custom_logs"
+
+def test_run_dag_from_subdir():
+    out = REPO / "tmp" / "test_subdir_run.json"
+    result = run_dag(
+        [str(REPO / "data" / "input.csv")],
+        str(out),
+        repo_root=str(REPO),
+        log_dir=str(REPO / "logs"),
+    )
+    report = json.loads(Path(result).read_text(encoding="utf-8"))
+    assert report["processed_count"] == 2
+    assert report["rejected_count"] == 1
