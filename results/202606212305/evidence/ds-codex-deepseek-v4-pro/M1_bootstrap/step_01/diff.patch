+"""DAG runner: extract -> clean -> report, with retry and logging."""
+import csv
+import json
+import logging
+import re
+import sys
+from pathlib import Path
+
+
+class HarnessError(Exception):
+    """Raised for harness-level failures."""
+
+
+def _to_snake_case(name):
+    s = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\g<1>_\g<2>", name)
+    s = re.sub(r"([a-z\d])([A-Z])", r"\g<1>_\g<2>", s)
+    s = re.sub(r"[-\s]+", "_", s)
+    return s.lower().strip("_")
+
+
+def _extract_csv(path):
+    records = []
+    with open(path, newline="", encoding="utf-8") as f:
+        reader = csv.DictReader(f)
+        for row in reader:
+            records.append({k: v for k, v in row.items() if k is not None})
+    return records
+
+
+def _extract_jsonl(path):
+    records = []
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                records.append(json.loads(line))
+    return records
+
+
+def _extract(inputs):
+    all_records = []
+    for path in inputs:
+        p = Path(path)
+        if p.suffix == ".csv":
+            all_records.extend(_extract_csv(str(p)))
+        elif p.suffix == ".jsonl":
+            all_records.extend(_extract_jsonl(str(p)))
+        else:
+            raise HarnessError(f"Unsupported file type: {path}")
+    return all_records
+
+
+def _clean(records):
+    processed = []
+    rejects = []
+    for rec in records:
+        if all(v is None or str(v).strip() == "" for v in rec.values()):
+            continue
+        cleaned = {_to_snake_case(k): v for k, v in rec.items()}
+        if "id" not in cleaned or cleaned["id"] is None or str(cleaned["id"]).strip() == "":
+            rejects.append(cleaned)
+        else:
+            processed.append(cleaned)
+    return processed, rejects
+
+
+def _report(processed, rejects, retry_count, source_files, output_path):
+    report = {
+        "processed_count": len(processed),
+        "rejected_count": len(rejects),
+        "retry_count": retry_count,
+        "source_files": source_files,
+    }
+    out = Path(output_path)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    with open(out, "w", encoding="utf-8") as f:
+        json.dump(report, f, indent=2)
+    return str(out)
+
+
+def _setup_logging(log_dir):
+    log_dir = Path(log_dir)
+    log_dir.mkdir(parents=True, exist_ok=True)
+    log_path = log_dir / "dag.log"
+    logger = logging.getLogger("mini_harness")
+    logger.setLevel(logging.DEBUG)
+    logger.handlers.clear()
+    fh = logging.FileHandler(str(log_path), encoding="utf-8")
+    fh.setLevel(logging.DEBUG)
+    fh.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
+    logger.addHandler(fh)
+    return logger
+
+
+def run_dag(inputs, output, repo_root=None):
+    if repo_root is None:
+        repo_root = str(Path(__file__).resolve().parent.parent)
+    repo = Path(repo_root)
+
+    logger = _setup_logging(str(repo / "logs"))
+    max_retries = 2
+    total_retries = 0
+
+    raw_records = None
+    processed = None
+    rejects = None
+
+    for stage_name in ("extract", "clean", "report"):
+        attempt = 1
+        last_error = None
+
+        while attempt <= max_retries + 1:
