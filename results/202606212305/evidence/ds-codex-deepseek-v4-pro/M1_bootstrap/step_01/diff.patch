+                    processed, rejects = _clean(raw_records)
+                elif stage_name == "report":
+                    if processed is None:
+                        raise HarnessError("clean must run before report")
+                    result = _report(processed, rejects, total_retries, inputs, output)
+                    logger.info("attempt=%d stage=%s status=ok", attempt, stage_name)
+                    return result
+
+                logger.info("attempt=%d stage=%s status=ok", attempt, stage_name)
+                break
+            except Exception as e:
+                last_error = e
+                if attempt <= max_retries:
+                    logger.warning("attempt=%d stage=%s status=retry error=%s", attempt, stage_name, e)
+                else:
+                    logger.error("attempt=%d stage=%s status=fail error=%s", attempt, stage_name, e)
+                attempt += 1
+                total_retries += 1
+        else:
+            raise HarnessError(f"Stage '{stage_name}' failed after {max_retries} retries: {last_error}")
+
+    return None
