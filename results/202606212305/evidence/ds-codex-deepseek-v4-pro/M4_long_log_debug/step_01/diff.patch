++++    records = []
++++    with open(path, encoding="utf-8") as f:
++++        for line in f:
++++            line = line.strip()
++++            if line:
++++                records.append(json.loads(line))
++++    return records
++++
++++
++++def _extract(inputs):
++++    all_records = []
