++{"milestone": "M2_config", "step": 4, "tool": "command_execution", "tool_output": "\"\"\"CLI for mini_harness using argparse only.\"\"\"\r\nimport argparse\r\nimport sys\r\nfrom pathlib import Path\r\nfrom mini_harness.runner import run_dag, HarnessError\r\n\r\n\r\ndef main(argv=None):\r\n    parser = argparse.ArgumentParser(prog=\"mini_harness\")\r\n    sub = parser.add_subparsers(dest=\"command\")\r\n\r\n    run_parser = sub.add_parser(\"run\", help=\"Run the data processing DAG\")\r\n    run_parser.add_argument(\"inputs\", nargs=\"+\", help=\"Input files (CSV or JSONL)\")\r\n    run_parser.add_argument(\"--output\", required=True, help=\"Output report path\")\r\n\r\n    args = parser.parse_args(argv)\r\n\r\n    if args.command != \"run\":\r\n        parser.print_help()\r\n        sys.exit(1)\r\n\r\n    repo_root = Path(__file__).resolve().parent.parent\r\n    inputs = [str(repo_root / p) if not Path(p).is_absolute() else p for p in args.inputs]\r\n    output = str(repo_root / args.output) if not Path(args.output).is_absolute() else args.output\r\n\r\n    try:\r\n        report = run_dag(inputs, output)\r\n        print(f\"Report written to {report}\")\r\n    except HarnessError as e:\r\n        print(f\"ERROR: {e}\", file=sys.stderr)\r\n        sys.exit(1)\r\n    return 0\r\n", "tool_error": false, "event_type": "tool_result", "event_id": "item_2"}
++{"milestone": "M2_config", "step": 5, "tool": "command_execution", "tool_output": "\"\"\"DAG runner: extract -> clean -> report, with retry and logging.\"\"\"\r\nimport csv\r\nimport json\r\nimport logging\r\nimport re\r\nimport sys\r\nfrom pathlib import Path\r\n\r\n\r\nclass HarnessError(Exception):\r\n    \"\"\"Raised for harness-level failures.\"\"\"\r\n\r\n\r\ndef _to_snake_case(name):\r\n    s = re.sub(r\"([A-Z]+)([A-Z][a-z])\", r\"\\g<1>_\\g<2>\", name)\r\n    s = re.sub(r\"([a-z\\d])([A-Z])\", r\"\\g<1>_\\g<2>\", s)\r\n    s = re.sub(r\"[-\\s]+\", \"_\", s)\r\n    return s.lower().strip(\"_\")\r\n\r\n\r\ndef _extract_csv(path):\r\n    records = []\r\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\r\n        reader = csv.DictReader(f)\r\n        for row in reader:\r\n            records.append({k: v for k, v in row.items() if k is not None})\r\n    return records\r\n\r\n\r\ndef _extract_jsonl(path):\r\n    records = []\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        for line in f:\r\n            line = line.strip()\r\n            if line:\r\n                records.append(json.loads(line))\r\n    return records\r\n\r\n\r\ndef _extract(inputs):\r\n    all_records = []\r\n    for path in inputs:\r\n        p = Path(path)\r\n        if p.suffix == \".csv\":\r\n            all_records.extend(_extract_csv(str(p)))\r\n        elif p.suffix == \".jsonl\":\r\n            all_records.extend(_extract_jsonl(str(p)))\r\n        else:\r\n            raise HarnessError(f\"Unsupported file type: {path}\")\r\n    return all_records\r\n\r\n\r\ndef _clean(records):\r\n    processed = []\r\n    rejects = []\r\n    for rec in records:\r\n        if all(v is None or str(v).strip() == \"\" for v in rec.values()):\r\n            continue\r\n        cleaned = {_to_snake_case(k): v for k, v in rec.items()}\r\n        if \"id\" not in cleaned or cleaned[\"id\"] is None or str(cleaned[\"id\"]).strip() == \"\":\r\n            rejects.append(cleaned)\r\n        else:\r\n            processed.append(cleaned)\r\n    return processed, rejects\r\n\r\n\r\ndef _report(processed, rejects, retry_count, source_files, output_path):\r\n    report = {\r\n        \"processed_count\": len(processed),\r\n        \"rejected_count\": len(rejects),\r\n        \"retry_count\": retry_count,\r\n        \"source_files\": source_files,\r\n    }\r\n    out = Path(output_path)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    with open(out, \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(report, f, indent=2)\r\n    return str(out)\r\n\r\n\r\ndef _setup_logging(log_dir):\r\n    log_dir = Path(log_dir)\r\n    log_dir.mkdir(parents=True, exist_ok=True)\r\n    log_path = log_dir / \"dag.log\"\r\n    logger = logging.getLogger(\"mini_harness\")\r\n    logger.setLevel(logging.DEBUG)\r\n    logger.handlers.clear()\r\n    fh = logging.FileHandler(str(log_path), encoding=\"utf-8\")\r\n    fh.setLevel(logging.DEBUG)\r\n    fh.setFormatter(logging.Formatter(\"%(asctime)s %(levelname)s %(message)s\"))\r\n    logger.addHandler(fh)\r\n    return logger\r\n\r\n\r\ndef run_dag(inputs, output, repo_root=None):\r\n    if repo_root is None:\r\n        repo_root = str(Path(__file__).resolve().parent.parent)\r\n    repo = Path(repo_root)\r\n\r\n    logger = _setup_logging(str(repo / \"logs\"))\r\n    max_retries = 2\r\n    total_retries = 0\r\n\r\n    raw_records = None\r\n    processed = None\r\n    rejects = None\r\n\r\n    for stage_name in (\"extract\", \"clean\", \"report\"):\r\n        attempt = 1\r\n        last_error = None\r\n\r\n        while attempt <= max_retries + 1:\r\n            try:\r\n                if stage_name == \"extract\":\r\n                    raw_records = _extract(inputs)\r\n                elif stage_name == \"clean\":\r\n                    if raw_records is None:\r\n                        raise HarnessError(\"extract must run before clean\")\r\n                    processed, rejects = _clean(raw_records)\r\n                elif stage_name == \"report\":\r\n                    if processed is None:\r\n                        raise HarnessError(\"clean must run before report\")\r\n                    result = _report(processed, rejects, total_retries, inputs, output)\r\n                    logger.info(\"attempt=%d stage=%s status=ok\", attempt, stage_name)\r\n                    return result\r\n\r\n                logger.info(\"attempt=%d stage=%s status=ok\", attempt, stage_name)\r\n                break\r\n            except Exception as e:\r\n                last_error = e\r\n                if attempt <= max_retries:\r\n                    logger.warning(\"attempt=%d stage=%s status=retry error=%s\", attempt, stage_name, e)\r\n                else:\r\n                    logger.error(\"attempt=%d stage=%s status=fail error=%s\", attempt, stage_name, e)\r\n                attempt += 1\r\n                total_retries += 1\r\n        else:\r\n            raise HarnessError(f\"Stage '{stage_name}' failed after {max_retries} retries: {last_error}\")\r\n\r\n    return None\r\n", "tool_error": false, "event_type": "tool_result", "event_id": "item_1"}
