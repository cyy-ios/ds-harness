+import csv
+import json
+import logging
+import os
+import sys
+
+logger = logging.getLogger(__name__)
+
+def run_dag(file_paths):
+    all_cleaned = []
+    all_rejected = []
+    source_files = []
+    total_retries = 0
+
+    for path in file_paths:
+        # extract
+        records = _run_stage_single("extract", path)
+        # clean
+        cleaned, rejected, retries = _clean_with_retry(records)
+        total_retries += retries
+        all_cleaned.extend(cleaned)
+        all_rejected.extend(rejected)
+        source_files.append(path)
+
+    report = {
+        "processed_count": len(all_cleaned),
+        "rejected_count": len(all_rejected),
+        "retry_count": total_retries,
+        "source_files": source_files
+    }
+
+    memory_path = "memory/memory_summary.md"
+    if os.path.exists(memory_path):
+        with open(memory_path, "r", encoding="utf-8") as f:
+            memory_summary = f.read()
+        report["memory_summary_reference"] = memory_path
+
+    return report
+
+def _run_stage_single(stage, path):
+    max_retries = 2
+    last_exception = None
+    for attempt in range(1, max_retries + 2):
+        log = {"stage": stage, "attempt": attempt, "status": "started"}
+        print(json.dumps(log))
+        try:
+            records = _extract_single(path)
+            log = {"stage": stage, "attempt": attempt, "status": "success"}
+            print(json.dumps(log))
+            return records
+        except Exception as e:
+            last_exception = e
+            log = {"stage": stage, "attempt": attempt, "status": "failed", "error": str(e)}
+            print(json.dumps(log))
+            if attempt > max_retries:
+                log = {"stage": stage, "attempt": attempt, "status": "abort"}
+                print(json.dumps(log))
+                sys.exit(1)
+    raise last_exception
+
+def _extract_single(path):
+    records = []
+    if path.endswith(".csv"):
+        with open(path, "r") as f:
+            lines = [l for l in f if not l.startswith("#")]
+            reader = csv.DictReader(lines)
+            for row in reader:
+                if any(v for v in row.values() if v):
+                    records.append(row)
+    elif path.endswith(".jsonl"):
+        with open(path, "r") as f:
+            for line in f:
+                line = line.strip()
+                if line:
+                    records.append(json.loads(line))
+    else:
+        raise ValueError(f"Unsupported file format: {path}")
+    return records
+
+def _clean_with_retry(records):
+    max_retries = 2
+    for attempt in range(1, max_retries + 2):
+        log = {"stage": "clean", "attempt": attempt, "status": "started"}
+        print(json.dumps(log))
+        try:
+            cleaned, rejected = _clean_single(records)
+            log = {"stage": "clean", "attempt": attempt, "status": "success"}
+            print(json.dumps(log))
+            return cleaned, rejected, (attempt - 1)
+        except Exception as e:
+            log = {"stage": "clean", "attempt": attempt, "status": "failed", "error": str(e)}
+            print(json.dumps(log))
+            if attempt > max_retries:
+                log = {"stage": "clean", "attempt": attempt, "status": "abort"}
+                print(json.dumps(log))
+                sys.exit(1)
+    return [], [], 0
+
+def _clean_single(records):
+    cleaned = []
+    rejected = []
+    for rec in records:
+        new_rec = {}
+        for k, v in rec.items():
+            snake_key = k.strip().lower().replace(" ", "_")
+            new_rec[snake_key] = v
+        if "id" not in new_rec or not new_rec["id"]:
+            rejected.append(new_rec)
+        else:
+            cleaned.append(new_rec)
+    return cleaned, rejected
