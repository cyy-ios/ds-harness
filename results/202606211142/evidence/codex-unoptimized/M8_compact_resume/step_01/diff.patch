+"""Workbench import shim for the fixture's real mini_harness package."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+
+def _real_package() -> Path | None:
+    for candidate in Path(__file__).resolve().parents:
+        package = candidate / "mini_harness"
+        if package.is_dir() and (candidate / "skills" / "data-harness" / "SKILL.md").exists():
+            return package
+    return None
+
+
+real_package = _real_package()
+if real_package is not None:
+    real_package_path = str(real_package)
+    if real_package_path not in __path__:
+        __path__.append(real_package_path)
+
+from .runner import HarnessError, run_dag  # noqa: E402
+
+__all__ = ["HarnessError", "run_dag"]
