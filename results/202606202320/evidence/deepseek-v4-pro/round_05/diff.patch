+import tempfile
+import os
+from mini_harness.runner import run_dag
+
+def test_run_dag_from_workbench():
+    # Create a temporary CSV file
+    content = "ID,Name,Score\n1,Alice,10\n2,Bob,20\n,Bad,0\n"
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.csv', delete=False) as f:
+        tmp_name = f.name
+        f.write(content)
+    try:
+        result = run_dag([tmp_name])
+        assert result["processed_count"] == 2
+        assert result["rejected_count"] == 1
+        assert set(result["source_files"]) == {tmp_name}
+    finally:
+        os.unlink(tmp_name)
