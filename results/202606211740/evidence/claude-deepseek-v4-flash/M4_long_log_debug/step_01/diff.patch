index 0000000..c0beba4
--- /dev/null
+++ b/mini_harness/utils.py
@@ -0,0 +1,68 @@
+import csv
+import json
+import io
+import re
+
+
+def _skip_comments(lines):
+    """Filter out comment lines (starting with # after optional whitespace)."""
+    for line in lines:
+        if line.lstrip().startswith("#"):
+            continue
+        yield line
+
+
+def read_csv(path: str) -> list[dict[str, str]]:
+    """Read a CSV file, return list of row-dicts. Skips #-comment lines."""
+    rows: list[dict[str, str]] = []
+    with open(path, newline="", encoding="utf-8") as f:
+        filtered = _skip_comments(f)
+        reader = csv.DictReader(filtered)
+        for row in reader:
+            if not row:
+                rows.append({})
+                continue
+            # Detect rows where a value is unexpectedly a list (extra fields
+            # beyond fieldnames — a sign the file's comment-header line was
+            # missed). Normalise every value to str.
+            normalised: dict[str, str] = {}
+            for k, v in row.items():
+                if isinstance(v, list):
+                    # extra fields under restkey — flatten and warn
+                    for item in v:
+                        normalised[k] = str(item) if item is not None else ""
+                else:
+                    normalised[k] = v if v is not None else ""
+            # If every value is empty, treat as blank line
+            if all(v.strip() == "" for v in normalised.values()):
+                rows.append({})
+            else:
+                rows.append(normalised)
+    return rows
+
+
+def read_jsonl(path: str) -> list[dict[str, str]]:
+    """Read a JSONL file, return list of dicts. Blank lines become empty dicts."""
+    rows: list[dict[str, str]] = []
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            stripped = line.strip()
+            if not stripped:
+                rows.append({})
+                continue
+            rows.append(json.loads(stripped))
+    return rows
+
+
+def snake_case(name: str) -> str:
+    """Convert a field name to snake_case."""
+    name = name.strip()
+    name = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1_\2", name)
+    name = re.sub(r"([a-z\d])([A-Z])", r"\1_\2", name)
+    name = re.sub(r"[-\s]+", "_", name)
+    return name.lower()
+
+
+def clean_record(record: dict) -> dict:
+    """Return a new dict with all keys converted to snake_case."""
+    return {snake_case(k): v for k, v in record.items()}
