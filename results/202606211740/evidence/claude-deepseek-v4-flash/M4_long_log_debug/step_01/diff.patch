+"""Configuration loader for JSON and YAML (stdlib-only fallback)."""
+
+import json
+import os
+import re
+from typing import Any
+
+
+def _parse_yaml_value(raw: str) -> Any:
+    """Coerce a YAML scalar string to Python value."""
+    v = raw.strip()
+    if v in ("", "null", "~"):
+        return None
+    if v in ("true", "True", "yes"):
+        return True
+    if v in ("false", "False", "no"):
+        return False
+    # int
+    try:
+        return int(v)
+    except ValueError:
+        pass
+    # float
+    try:
+        return float(v)
+    except ValueError:
+        pass
+    # strip surrounding quotes
+    if len(v) >= 2 and v[0] == v[-1] and v[0] in ('"', "'"):
+        return v[1:-1]
+    return v
+
+
+def _parse_yaml(text: str) -> dict:
+    """Minimal YAML subset parser: nested dicts, lists, scalars, comments."""
+    data: dict = {}
+    stack: list[tuple[int, dict]] = [(-1, data)]
+    list_context: list[dict | None] = []
+    list_key: str | None = None
+    list_indent: int = -1
+
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+
+        indent = len(line) - len(line.lstrip())
+        # Strip trailing comment (respect quotes)
+        in_quote = None
+        comment_pos = -1
+        for i, ch in enumerate(stripped):
+            if ch in ('"', "'"):
+                if in_quote == ch:
+                    in_quote = None
+                elif in_quote is None:
+                    in_quote = ch
+            elif ch == "#" and in_quote is None and comment_pos < 0:
+                comment_pos = i
+                break
+        if comment_pos >= 0:
+            stripped = stripped[:comment_pos].rstrip()
+
+        if not stripped:
+            continue
+
+        # List item
+        if stripped.startswith("- "):
+            content = stripped[2:].strip()
+            # Pop back to parent indent level
+            while len(stack) > 1 and indent <= stack[-1][0]:
+                stack.pop()
+            parent = stack[-1][1]
+            # Find or create the list key in parent
+            if list_key is not None and indent == list_indent:
+                pass  # continuing same list
+            else:
+                # Scan for the last key that holds a list
+                for k, v in parent.items():
+                    if isinstance(v, list):
+                        list_key_local = k
+                        break
+                else:
+                    # Create new list under the key from previous line
+                    # We need to find the key name from the last non-list line
+                    list_key_local = list_key
+                list_key = list_key_local
+                list_indent = indent
+
+            if list_key and list_key in parent and isinstance(parent[list_key], list):
+                parent[list_key].append(_parse_yaml_value(content))
+            else:
+                parent[list_key] = [_parse_yaml_value(content)]
+            continue
+
+        # Key: value
+        if ": " in stripped or stripped.endswith(":"):
+            if stripped.endswith(":"):
+                key = stripped[:-1].strip()
+                raw_value = ""
+            else:
+                key, raw_value = stripped.split(": ", 1)
+                key = key.strip()
+                raw_value = raw_value.strip()
+
+            # Pop stack to correct indent level
+            while len(stack) > 1 and indent <= stack[-1][0]:
+                stack.pop()
+            parent = stack[-1][1]
+
+            if raw_value:
+                parent[key] = _parse_yaml_value(raw_value)
+            else:
+                # New nested mapping
+                new_dict: dict = {}
+                # Try to create list if this ends with list marker
+                parent[key] = new_dict
+                stack.append((indent, new_dict))
+                list_key = key
+                list_indent = indent + 2  # will be overwritten on first list item
+        else:
+            # Key without colon-space (edge case)
+            if ":" in stripped:
+                key = stripped.split(":", 1)[0].strip()
+                if key:
+                    parent = stack[-1][1]
+                    parent[key] = None
+
+    return data
+
+
+def load_config(path: str) -> dict[str, Any]:
+    """Load a JSON or YAML config file and return as dict.
+
+    Format is determined by file extension (.json / .yaml / .yml).
+    YAML parsing falls back to a minimal stdlib-only parser when
+    PyYAML is not available.
+    """
+    ext = os.path.splitext(path)[1].lower()
+    with open(path, encoding="utf-8") as f:
+        if ext == ".json":
+            return json.load(f)
+        elif ext in (".yaml", ".yml"):
+            try:
+                import yaml
+            except ImportError:
+                return _parse_yaml(f.read())
+            return yaml.safe_load(f.read()) or {}
+        else:
+            raise ValueError(f"Unsupported config format: {ext} (use .json, .yaml, .yml)")
