@@ -0,0 +1,141 @@
+"""DAG runner: extract → clean → report with retry logic."""
+
+import logging
+import os
+import json
+from datetime import datetime
+from typing import Any
+
+from mini_harness.utils import read_csv, read_jsonl, clean_record
+
+logger = logging.getLogger("mini_harness")
+
+
+class HarnessError(Exception):
+    """Base exception for harness pipeline errors."""
+
+
+def _stage_runner(
+    stage: str,
+    fn,
+    max_retries: int,
+    retry_counter: list[int],
+    detail_key: str | None = None,
+) -> Any:
+    """Run a stage with retry logic.
+
+    Args:
+        stage: Stage name for logging.
+        fn: Callable that performs the stage work.
+        max_retries: Max retry attempts.
+        retry_counter: Shared list with one element to track retry count.
+        detail_key: If set, fn returns a dict; log detail_key=value pairs.
+
+    Returns:
+        The result from fn on success.
+    """
+    for attempt in range(1, max_retries + 2):
+        logger.info("%s attempt=%d stage=%s status=running", stage, attempt, stage)
+        try:
+            result = fn(attempt)
+            if attempt > 1:
+                retry_counter[0] += 1
+            extra = ""
+            if detail_key and isinstance(result, dict):
+                extra = " " + " ".join(f"{k}={v}" for k, v in result.items())
+            logger.info("%s attempt=%d stage=%s status=ok%s", stage, attempt, stage, extra)
+            return result
+        except Exception as e:
+            logger.warning("%s attempt=%d stage=%s status=failed error=%s", stage, attempt, stage, e)
+            if attempt > 1:
+                retry_counter[0] += 1
+            if attempt > max_retries:
+                raise HarnessError(f"Stage '{stage}' failed after {attempt} attempts") from e
+
+    raise HarnessError(f"Stage '{stage}' exited retry loop unexpectedly")
+
+
+def run_dag(
+    sources: list[str],
+    output: str = "tmp/report.json",
+    max_retries: int = 2,
+    memory_ref: str = "memory/memory_summary.md",
+) -> dict[str, Any]:
+    """Run the full DAG pipeline: extract → clean → report.
+
+    Args:
+        sources: List of file paths (CSV or JSONL).
+        output: Path to write the final report JSON.
+        max_retries: Max retries per stage (default 2).
+        memory_ref: Path to memory summary to reference in report.
+    """
+    retry_counter: list[int] = [0]
+    all_records: list[dict] = []
+    source_files: list[str] = []
+
+    # --- extract ---
+    def _extract(_attempt: int) -> dict:
+        all_records.clear()
+        source_files.clear()
+        for path in sources:
+            if not os.path.isfile(path):
+                raise HarnessError(f"Source not found: {path}")
+            if path.endswith(".csv"):
+                rows = read_csv(path)
+            elif path.endswith(".jsonl"):
+                rows = read_jsonl(path)
+            else:
+                raise HarnessError(f"Unsupported format: {path}")
+            source_files.append(os.path.abspath(path))
+            all_records.extend(rows)
+        return {"sources": len(source_files)}
+
+    _stage_runner("extract", _extract, max_retries, retry_counter, detail_key="extract")
+
+    # --- clean ---
+    processed: list[dict] = []
+    rejected: list[dict] = []
+
+    def _clean(_attempt: int) -> dict:
+        processed.clear()
+        rejected.clear()
+        for record in all_records:
+            if not record:
+                continue
+            cleaned = clean_record(record)
+            if not cleaned.get("id") or cleaned["id"].strip() == "":
+                rejected.append(cleaned)
+            else:
+                processed.append(cleaned)
+        return {"processed": len(processed), "rejected": len(rejected)}
+
+    _stage_runner("clean", _clean, max_retries, retry_counter, detail_key="clean")
+
+    # --- report ---
+    report: dict | None = None
+
+    def _report(_attempt: int) -> dict:
+        nonlocal report
+        os.makedirs(os.path.dirname(output) or ".", exist_ok=True)
+        report = {
+            "pipeline": "mini_harness",
+            "generated_at": datetime.now().isoformat(),
+            "processed_count": len(processed),
+            "rejected_count": len(rejected),
+            "retry_count": retry_counter[0],
+            "source_files": source_files,
+            "memory_reference": memory_ref,
+            "stages": {
+                "extract": {"status": "ok", "sources": len(source_files)},
+                "clean": {"status": "ok", "processed": len(processed), "rejected": len(rejected)},
+                "report": {"status": "ok"},
+            },
+        }
+        with open(output, "w", encoding="utf-8") as f:
+            json.dump(report, f, indent=2, ensure_ascii=False)
+        return {"output": output}
+
+    _stage_runner("report", _report, max_retries, retry_counter)
+
+    # report is guaranteed non-None after _report succeeds
+    return report  # type: ignore[return-value]
