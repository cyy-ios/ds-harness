index 0000000..b3d707b
--- /dev/null
+++ b/mini_harness/utils.py
@@ -0,0 +1,46 @@
+import csv
+import json
+import io
+import re
+
+
+def read_csv(path: str) -> list[dict[str, str]]:
+    """Read a CSV file, return list of row-dicts. Empty lines are returned as empty dicts."""
+    rows: list[dict[str, str]] = []
+    with open(path, newline="", encoding="utf-8") as f:
+        reader = csv.DictReader(f)
+        for row in reader:
+            # If every value is empty/None, treat as blank line
+            if row and all(v is None or v.strip() == "" for v in row.values()):
+                rows.append({})
+            else:
+                # Normalize None to empty string
+                rows.append({k: (v if v is not None else "") for k, v in row.items()})
+    return rows
+
+
+def read_jsonl(path: str) -> list[dict[str, str]]:
+    """Read a JSONL file, return list of dicts. Blank lines become empty dicts."""
+    rows: list[dict[str, str]] = []
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            stripped = line.strip()
+            if not stripped:
+                rows.append({})
+                continue
+            rows.append(json.loads(stripped))
+    return rows
+
+
+def snake_case(name: str) -> str:
+    """Convert a field name to snake_case."""
+    name = name.strip()
+    name = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1_\2", name)
+    name = re.sub(r"([a-z\d])([A-Z])", r"\1_\2", name)
+    name = re.sub(r"[-\s]+", "_", name)
+    return name.lower()
+
+
+def clean_record(record: dict) -> dict:
+    """Return a new dict with all keys converted to snake_case."""
+    return {snake_case(k): v for k, v in record.items()}
