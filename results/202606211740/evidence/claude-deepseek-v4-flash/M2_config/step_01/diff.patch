+"""CLI entry point for mini_harness."""
+
+import argparse
+import logging
+import sys
+import os
+
+from mini_harness.config import load_config
+from mini_harness.runner import run_dag
+
+DEFAULTS = {
+    "sources": [],
+    "output": "tmp/report.json",
+    "max_retries": 2,
+}
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="mini_harness")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    run_parser = sub.add_parser("run", help="Run the DAG pipeline")
+    run_parser.add_argument("--config", "-c", help="Config file path (.json / .yaml / .yml)")
+    run_parser.add_argument("sources", nargs="*", help="Input CSV or JSONL files")
+    run_parser.add_argument("--output", help="Output report path (overrides config)")
+    run_parser.add_argument("--max-retries", type=int, help="Max retries per stage (overrides config)")
+    run_parser.add_argument("--verbose", "-v", action="store_true", help="Enable DEBUG logging")
+
+    return parser
+
+
+def _merge(config: dict, args: argparse.Namespace) -> dict:
+    """Merge CLI args over config values. CLI wins."""
+    merged = dict(DEFAULTS)
+    merged.update(config)
+    if args.sources:
+        merged["sources"] = args.sources
+    if args.output:
+        merged["output"] = args.output
+    if args.max_retries is not None:
+        merged["max_retries"] = args.max_retries
+    return merged
+
+
+def main(argv: list[str] | None = None) -> None:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+
+    logging.basicConfig(
+        level=logging.DEBUG if args.verbose else logging.INFO,
+        format="%(levelname)s %(name)s %(message)s",
+        stream=sys.stderr,
+    )
+
+    if args.command != "run":
+        parser.print_help()
+        return
+
+    config = {}
+    if args.config:
+        if not os.path.isfile(args.config):
+            print(f"Config file not found: {args.config}", file=sys.stderr)
+            sys.exit(1)
+        config = load_config(args.config)
+
+    merged = _merge(config, args)
+
+    if not merged["sources"]:
+        print("Error: no source files specified (provide on CLI or in config)", file=sys.stderr)
+        sys.exit(1)
+
+    report = run_dag(
+        sources=merged["sources"],
+        output=merged["output"],
+        max_retries=merged["max_retries"],
+    )
+    print(f"Report written to {merged['output']}")
+    print(f"  processed: {report['processed_count']}, rejected: {report['rejected_count']}")
