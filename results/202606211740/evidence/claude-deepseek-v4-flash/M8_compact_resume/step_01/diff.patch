--- a/mini_harness/utils.py
+++ b/mini_harness/utils.py
@@ -1,9 +1,39 @@
 import csv
 import json
 import io
+import os
 import re
 
 
+def get_project_root() -> str:
+    """Return the repo root by walking up from this package's location."""
+    # utils.py is at <root>/mini_harness/utils.py
+    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def resolve_path(path: str, project_root: str | None = None) -> str:
+    """Resolve *path* relative to *project_root* if it's a project-internal path.
+
+    Rules:
+    1. Absolute paths are returned as-is.
+    2. If the path resolves from CWD and exists, use CWD-relative.
+    3. Otherwise, try resolving relative to *project_root*.
+    """
+    if os.path.isabs(path):
+        return path
+    if project_root is None:
+        project_root = get_project_root()
+    cwd = os.getcwd()
+    cwd_path = os.path.normpath(os.path.join(cwd, path))
+    if os.path.exists(cwd_path):
+        return cwd_path
+    root_path = os.path.normpath(os.path.join(project_root, path))
+    if os.path.exists(root_path):
+        return root_path
+    # Neither exists — prefer CWD-relative (let the caller decide with a real error)
+    return cwd_path
+
+
