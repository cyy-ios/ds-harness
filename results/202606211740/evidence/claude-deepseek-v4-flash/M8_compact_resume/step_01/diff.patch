@@ -0,0 +1,51 @@
+"""Report generation for mini_harness DAG pipeline."""
+
+import json
+import os
+from datetime import datetime
+from typing import Any
+
+
+def build_report(
+    processed_count: int,
+    rejected_count: int,
+    retry_count: int,
+    source_files: list[str],
+    memory_ref: str | None = None,
+) -> dict[str, Any]:
+    """Build the standard report dict."""
+    report: dict[str, Any] = {
+        "pipeline": "mini_harness",
+        "generated_at": datetime.now().isoformat(),
+        "processed_count": processed_count,
+        "rejected_count": rejected_count,
+        "retry_count": retry_count,
+        "source_files": source_files,
+        "stages": {
+            "extract": {"status": "ok", "sources": len(source_files)},
+            "clean": {
+                "status": "ok",
+                "processed": processed_count,
+                "rejected": rejected_count,
+            },
+            "report": {"status": "ok"},
+        },
+    }
+    if memory_ref:
+        report["memory_reference"] = memory_ref
+    return report
+
+
+def write_report(report: dict[str, Any], output: str) -> None:
+    """Write report dict to a JSON file."""
+    os.makedirs(os.path.dirname(os.path.abspath(output)) or ".", exist_ok=True)
+    with open(output, "w", encoding="utf-8") as f:
+        json.dump(report, f, indent=2, ensure_ascii=False)
+
+
+def load_memory_summary(memory_ref: str) -> str | None:
+    """Load and return memory summary content if the file exists."""
+    if os.path.isfile(memory_ref):
+        with open(memory_ref, encoding="utf-8") as f:
+            return f.read()
+    return None
