+"""DAG runner: extract → clean → report with retry logic."""
+
+import logging
+import os
+import json
+from datetime import datetime
+from typing import Any
+
+from mini_harness.utils import read_csv, read_jsonl, clean_record
+
+logger = logging.getLogger("mini_harness")
+
+
+class HarnessError(Exception):
+    """Base exception for harness pipeline errors."""
+
+
+def run_dag(
+    sources: list[str],
+    output: str = "tmp/report.json",
+    max_retries: int = 2,
+    memory_ref: str = "memory/memory_summary.md",
+) -> dict[str, Any]:
+    """Run the full DAG pipeline: extract → clean → report.
+
+    Args:
+        sources: List of file paths (CSV or JSONL).
+        output: Path to write the final report JSON.
+        max_retries: Max retries per stage (default 2).
+        memory_ref: Path to memory summary to reference in report.
+    """
+    # --- extract ---
+    extract_ok = False
+    all_records: list[dict] = []
+    source_files: list[str] = []
+    for attempt in range(1, max_retries + 2):  # first try + retries
+        try:
+            logger.info("extract attempt=%d stage=extract status=running", attempt)
+            all_records.clear()
+            source_files.clear()
+            for path in sources:
+                if not os.path.isfile(path):
+                    raise HarnessError(f"Source not found: {path}")
+                if path.endswith(".csv"):
+                    rows = read_csv(path)
+                elif path.endswith(".jsonl"):
+                    rows = read_jsonl(path)
+                else:
+                    raise HarnessError(f"Unsupported format: {path}")
+                source_files.append(os.path.abspath(path))
+                all_records.extend(rows)
+            extract_ok = True
+            logger.info("extract attempt=%d stage=extract status=ok sources=%d", attempt, len(source_files))
+            break
+        except Exception as e:
+            logger.warning("extract attempt=%d stage=extract status=failed error=%s", attempt, e)
+            if attempt > max_retries:
+                raise HarnessError(f"Extract failed after {attempt} attempts") from e
+
+    # --- clean ---
+    clean_ok = False
+    processed: list[dict] = []
+    rejected: list[dict] = []
+    for attempt in range(1, max_retries + 2):
+        try:
+            logger.info("clean attempt=%d stage=clean status=running", attempt)
+            processed.clear()
+            rejected.clear()
+            for record in all_records:
+                # Remove blank lines (empty dicts)
+                if not record:
+                    continue
+                cleaned = clean_record(record)
+                if not cleaned.get("id") or cleaned["id"].strip() == "":
+                    rejected.append(cleaned)
+                else:
+                    processed.append(cleaned)
+            clean_ok = True
+            logger.info("clean attempt=%d stage=clean status=ok processed=%d rejected=%d", attempt, len(processed), len(rejected))
+            break
+        except Exception as e:
+            logger.warning("clean attempt=%d stage=clean status=failed error=%s", attempt, e)
+            if attempt > max_retries:
+                raise HarnessError(f"Clean failed after {attempt} attempts") from e
+
+    # --- report ---
+    retry_count = 0
+    report_ok = False
+    for attempt in range(1, max_retries + 2):
+        try:
+            logger.info("report attempt=%d stage=report status=running", attempt)
+            os.makedirs(os.path.dirname(output) or ".", exist_ok=True)
+            report = {
+                "pipeline": "mini_harness",
+                "generated_at": datetime.now().isoformat(),
+                "processed_count": len(processed),
+                "rejected_count": len(rejected),
+                "retry_count": retry_count,
+                "source_files": source_files,
+                "memory_reference": memory_ref,
+                "stages": {
+                    "extract": {"status": "ok", "sources": len(source_files)},
+                    "clean": {"status": "ok", "processed": len(processed), "rejected": len(rejected)},
+                    "report": {"status": "ok"},
+                },
+            }
+            with open(output, "w", encoding="utf-8") as f:
+                json.dump(report, f, indent=2, ensure_ascii=False)
+            report_ok = True
+            logger.info("report attempt=%d stage=report status=ok output=%s", attempt, output)
+            break
+        except Exception as e:
+            logger.warning("report attempt=%d stage=report status=failed error=%s", attempt, e)
+            if attempt > max_retries:
+                raise HarnessError(f"Report failed after {attempt} attempts") from e
+
+    return report
