+﻿"""Report builder and writer for mini_harness DAG output."""
+
+import json
+import os
+
+
+def build_report(clean_records, rejects, retry_count, source_files, logs=None,
+                 memory_path=None):
+    """Build a structured report dict from DAG results.
+
+    Parameters
+    ----------
+    clean_records : list[dict]
+        Records that passed cleaning.
+    rejects : list[dict]
+        Rejected records with reason.
+    retry_count : int
+        Number of retries performed.
+    source_files : list[str]
+        Basenames of input source files.
+    logs : list[dict] or None
+        Structured log entries from the DAG run.
+    memory_path : str or None
+        Path to memory_summary.md to include as reference.
+
+    Returns
+    -------
+    dict with processed_count, rejected_count, retry_count, source_files,
+    rejects, logs, and memory_reference.
+    """
+    memory_ref = ""
+    if memory_path and os.path.exists(memory_path):
+        try:
+            with open(memory_path, "r", encoding="utf-8") as f:
+                memory_ref = f.read().strip()
+        except OSError:
+            memory_ref = "(failed to read memory)"
+
+    return {
+        "processed_count": len(clean_records),
+        "rejected_count": len(rejects),
+        "retry_count": retry_count,
+        "source_files": source_files,
+        "rejects": rejects,
+        "logs": logs or [],
+        "memory_reference": memory_ref,
+    }
+
+
+def write_report(report, output_path):
+    """Write a report dict to disk as JSON.
+
+    Parameters
+    ----------
+    report : dict
+        Report dict to serialize.
+    output_path : str
+        Absolute or repo-root-relative output file path.
+        Parent directories are created if they do not exist.
+    """
+    out_dir = os.path.dirname(output_path)
+    if out_dir:
+        os.makedirs(out_dir, exist_ok=True)
+    with open(output_path, "w", encoding="utf-8") as f:
+        json.dump(report, f, ensure_ascii=False, indent=2)
