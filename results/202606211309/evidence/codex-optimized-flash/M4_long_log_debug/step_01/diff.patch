+﻿"""Configuration loader for mini_harness — supports JSON and YAML (stdlib-only)."""
+
+import json
+import os
+import re
+
+
+class ConfigError(Exception):
+    """Raised when config parsing fails."""
+    pass
+
+
+def _parse_yaml(text, source="<string>"):
+    """Minimal YAML parser for the subset needed: mappings, lists, scalars."""
+    lines = text.split("\n")
+    # strip trailing whitespace from each line; keep leading indent
+    lines = [line.rstrip() for line in lines]
+
+    # Remove BOM
+    if lines and lines[0].startswith("\ufeff"):
+        lines[0] = lines[0][1:]
+
+    # Strip leading blank lines
+    while lines and not lines[0].strip():
+        lines.pop(0)
+
+    if not lines:
+        return {}
+
+    # Strip trailing blank lines
+    while lines and not lines[-1].strip():
+        lines.pop()
+
+    result, _ = _yaml_parse_block(lines, 0, 0)
+    return result
+
+
+def _yaml_parse_block(lines, start, base_indent):
+    """Parse a block of YAML lines starting at `start` with given base indent."""
+    result = {}
+    i = start
+    while i < len(lines):
+        line = lines[i]
+        if not line.strip() or line.strip().startswith("#"):
+            i += 1
+            continue
+
+        indent = len(line) - len(line.lstrip())
+        if indent < base_indent:
+            # we've gone past our block
+            break
+
+        stripped = line.strip()
+
+        # List item?
+        if stripped.startswith("- "):
+            key, val, consumed = _yaml_parse_list_item(lines, i, base_indent)
+            if key is not None:
+                result[key] = val
+                i = consumed
+                continue
+            # list without a key above it -> this is a sequence at the top scope
+            # but we handle this at the dispatch level
+            i += 1
+            continue
+
+        # Key: value pair
+        colon_idx = stripped.find(":")
+        if colon_idx == -1:
+            i += 1
+            continue
+
+        key = stripped[:colon_idx].strip()
+        rest = stripped[colon_idx + 1:].strip()
+
+        if not rest:
+            # value may be a nested block or a list
+            # Peek at next non-comment line
+            j = i + 1
+            while j < len(lines) and (not lines[j].strip() or lines[j].strip().startswith("#")):
+                j += 1
+            if j < len(lines):
+                next_line = lines[j]
+                next_indent = len(next_line) - len(next_line.lstrip())
+                if next_indent > indent:
+                    if next_line.strip().startswith("- "):
+                        # list
+                        val, consumed = _yaml_parse_list(lines, j, next_indent)
+                        result[key] = val
+                        i = consumed
+                        continue
+                    else:
+                        # nested mapping
+                        nested, consumed = _yaml_parse_block(lines, j, next_indent)
+                        result[key] = nested
+                        i = consumed
+                        continue
+            # empty value
+            result[key] = None
+            i += 1
+        else:
+            result[key] = _yaml_scalar(rest)
+            i += 1
+
+    return result, i
+
+
+def _yaml_scalar(value):
+    """Parse a YAML scalar value."""
+    value = value.strip()
+    if value.startswith("#"):
+        return None
+    # strip inline comment
+    comment_pos = _find_unquoted_hash(value)
+    if comment_pos > 0:
+        value = value[:comment_pos].strip()
+
+    if not value:
+        return None
+
+    # Quoted strings
+    if (value.startswith('"') and value.endswith('"')) or \
+       (value.startswith("'") and value.endswith("'")):
+        return value[1:-1]
+
+    # Booleans
+    if value.lower() in ("true", "yes", "on"):
+        return True
+    if value.lower() in ("false", "no", "off"):
+        return False
+
+    # Null
+    if value.lower() in ("null", "~", ""):
+        return None
+
+    # Integers
+    try:
+        return int(value)
+    except ValueError:
+        pass
+
+    # Floats
+    try:
+        return float(value)
+    except ValueError:
+        pass
+
+    return value
+
+
+def _find_unquoted_hash(text):
+    """Find # that is not inside quotes."""
+    in_dq = False
+    in_sq = False
+    for idx, ch in enumerate(text):
+        if ch == '"' and not in_sq:
+            in_dq = not in_dq
+        elif ch == "'" and not in_dq:
+            in_sq = not in_sq
+        elif ch == "#" and not in_dq and not in_sq:
+            return idx
+    return -1
+
+
+def _yaml_parse_list(lines, start, base_indent):
+    """Parse a YAML list block starting at `start`."""
+    items = []
+    i = start
+    while i < len(lines):
+        line = lines[i]
+        if not line.strip() or line.strip().startswith("#"):
+            i += 1
+            continue
+
+        indent = len(line) - len(line.lstrip())
+        if indent < base_indent:
+            break
+
+        stripped = line.strip()
+        if stripped.startswith("- "):
+            _key, val, consumed = _yaml_parse_list_item(lines, i, base_indent)
+            if (val is not None and _key is None) or consumed > i:
+                items.append(val)
+                i = consumed
+            else:
+                i += 1
+        else:
+            break
+
+    return items, i
+
+
+def _yaml_parse_list_item(lines, start, base_indent):
+    """Parse a single `- ` list item, possibly with nested key: value."""
+    line = lines[start]
+    stripped = line.strip()
+    indent = len(line) - len(line.lstrip())
+
+    if not stripped.startswith("- "):
+        return None, None, start
+
+    content = stripped[2:].strip()
+
+    # List item with inline key: value (e.g. "- key: val")
+    colon_idx = content.find(":")
+    if colon_idx > 0 and not content.startswith('"') and not content.startswith("'"):
+        # Check if this is key: value or just a string with colon
+        # If there's no space after colon, treat as string
+        key = content[:colon_idx].strip()
+        rest = content[colon_idx + 1:].strip()
+
+        if rest:
+            # simple inline key: value
+            return key, _yaml_scalar(rest), start + 1
+        else:
+            # key with nested value on next lines
+            j = start + 1
+            while j < len(lines) and (not lines[j].strip() or lines[j].strip().startswith("#")):
+                j += 1
+            if j < len(lines):
+                next_line = lines[j]
+                next_indent = len(next_line) - len(next_line.lstrip())
+                if next_indent > indent + 2:
+                    if next_line.strip().startswith("- "):
+                        list_val, consumed = _yaml_parse_list(lines, j, next_indent)
+                        return key, list_val, consumed
+                    else:
+                        nested, consumed = _yaml_parse_block(lines, j, next_indent)
+                        return key, nested, consumed
+            return key, None, j
+    elif not content:
+        # bare dash, next lines contain content
+        j = start + 1
+        while j < len(lines) and (not lines[j].strip() or lines[j].strip().startswith("#")):
+            j += 1
+        if j < len(lines):
+            next_line = lines[j]
+            next_indent = len(next_line) - len(next_line.lstrip())
+            if next_line.strip().startswith("- "):
+                items, consumed = _yaml_parse_list(lines, j, next_indent)
+                return None, items, consumed
+            else:
+                nested, consumed = _yaml_parse_block(lines, j, next_indent)
+                return None, nested, consumed
+        return None, None, j
+    else:
+        # plain string scalar
+        return None, _yaml_scalar(content), start + 1
+
+
+def load_config(path):
+    """Load a JSON or YAML config file and return a dict."""
+    if not os.path.exists(path):
+        raise ConfigError(f"Config file not found: {path}")
+
+    ext = os.path.splitext(path)[1].lower()
+    with open(path, "r", encoding="utf-8") as f:
+        text = f.read()
+
+    if ext == ".json":
+        try:
+            return json.loads(text)
+        except json.JSONDecodeError as e:
+            raise ConfigError(f"Invalid JSON in {path}: {e}") from e
+    elif ext in (".yaml", ".yml"):
+        try:
+            return _parse_yaml(text, path)
+        except Exception as e:
+            raise ConfigError(f"Invalid YAML in {path}: {e}") from e
+    else:
+        raise ConfigError(f"Unsupported config format: {ext} (use .json, .yaml, or .yml)")
+
+
+def merge_config(args, cfg):
+    """Merge CLI args (higher precedence) with config dict (lower precedence).
+
+    Returns (sources, output_path) resolved from the merge.
+    """
+    # If CLI provided explicit sources, use them; otherwise fall back to config
+    sources = cfg.get("sources") or []
+
+    # output: CLI --output wins over config
+    output = cfg.get("output")
+
+    return sources, output
