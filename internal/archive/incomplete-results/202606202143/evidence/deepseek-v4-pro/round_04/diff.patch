+    def _read_csv(self, path: Path) -> list[dict]:
+        """Read CSV file, skipping comment lines (starting with #) and empty lines."""
+        all_rows = []
+        with open(path, newline='', encoding='utf-8') as f:
+            # Read all lines, filter out comments and blank lines
+            lines = [line for line in f if line.strip() and not line.lstrip().startswith('#')]
+        if not lines:
+            return []
+        # Use csv.DictReader on the filtered list
+        reader = csv.DictReader(lines)
+        for row in reader:
+            # Skip rows where key is None (leftover from extra fields? but shouldn't happen)
+            if None in row:
+                del row[None]
+            all_rows.append(row)
+        return all_rows
