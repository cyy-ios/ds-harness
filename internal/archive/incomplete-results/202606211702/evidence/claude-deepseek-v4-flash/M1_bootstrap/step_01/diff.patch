+"""DAG stages — extract, clean, report."""
+
+import logging
+import os
+
+from mini_harness.utils import read_csv, read_jsonl, to_snake_case
+
+logger = logging.getLogger(__name__)
+
+
+def extract(paths: list[str]) -> list[dict]:
+    """Extract stage — read all source files, return raw records.
+
+    Supports ``.csv`` and ``.jsonl``; delegates by extension.
+    """
+    raw: list[dict] = []
+    for path in paths:
+        ext = os.path.splitext(path)[1].lower()
+        if ext == ".csv":
+            per_file = read_csv(path)
+        elif ext in (".jsonl", ".json"):
+            per_file = read_jsonl(path)
+        else:
+            per_file = _auto_detect(path)
+        raw.extend(per_file)
+        logger.info("Extracted %d records from %s", len(per_file), path)
+    return raw
+
+
+def _auto_detect(path: str) -> list[dict]:
+    """Try JSONL then CSV for unknown extensions."""
+    try:
+        return read_jsonl(path)
+    except Exception:
+        return read_csv(path)
+
+
+def clean(records: list[dict]) -> tuple[list[dict], list[dict]]:
+    """Clean stage — normalise field names; split by ``id`` presence.
+
+    Returns a ``(cleaned, rejects)`` pair.
+    """
+    cleaned: list[dict] = []
+    rejects: list[dict] = []
+
+    for rec in records:
+        if rec is None:
+            continue
+        # Convert all keys to snake_case
+        normalised = {
+            to_snake_case(str(k) if k is not None else ""): v
+            for k, v in rec.items()
+            if k is not None and k != ""
+        }
+        # Records without a truthy ``id`` are rejects
+        raw_id = normalised.get("id")
+        if raw_id is None or str(raw_id).strip() == "":
+            rejects.append(normalised)
+        else:
+            cleaned.append(normalised)
+
+    logger.info("Clean: %d accepted, %d rejected", len(cleaned), len(rejects))
+    return cleaned, rejects
+
+
+def report(
+    cleaned: list[dict],
+    rejects: list[dict],
+    retry_count: int,
+    source_files: list[str],
+) -> dict:
+    """Report stage — produce the final summary dict.
+
+    The output always references ``memory/memory_summary.md`` as required by
+    the data-harness skill.
+    """
+    return {
+        "processed_count": len(cleaned),
+        "rejected_count": len(rejects),
+        "retry_count": retry_count,
+        "source_files": source_files,
+        "memory_reference": "memory/memory_summary.md",
+    }
