+"""CLI entry-point — argparse-based run subcommand."""
+
+import argparse
+import logging
+import sys
+
+from mini_harness.runner import run_dag, HarnessError
+
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s [%(levelname)s] %(message)s",
+    datefmt="%H:%M:%S",
+)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    """Build argument parser with a ``run`` subcommand."""
+    parser = argparse.ArgumentParser(prog="mini_harness")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    run_p = sub.add_parser("run", help="Run the extract → clean → report DAG")
+    run_p.add_argument("sources", nargs="+", help="Input file(s) — CSV / JSONL")
+    run_p.add_argument(
+        "--output", "-o", default="tmp/report.json",
+        help="Output report path (default: tmp/report.json)",
+    )
+
+    return parser
+
+
+def main(argv: list[str] | None = None) -> None:
+    """CLI entry-point."""
+    parser = build_parser()
+    args = parser.parse_args(argv)
+
+    if args.command == "run":
+        try:
+            result = run_dag(args.sources, args.output)
+            print(f"Report written to {args.output}")
+            print(f"  processed: {result['processed_count']}, "
+                  f"rejected: {result['rejected_count']}, "
+                  f"retries: {result['retry_count']}")
+        except HarnessError as exc:
+            logging.error("Harness failed: %s", exc)
+            sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
